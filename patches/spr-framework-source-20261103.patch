+def queue_layout(ini, cpus):
+    """Keep split-IQ provenance; map only its total capacity as a proxy."""
+    layouts = {}
+    capacities = set()
+    for cpu in cpus:
+        queues = ini[cpu]["instQueues"].split()
+        if not queues:
+            raise RuntimeError("actual detailed CPU has no instruction queues")
+        layouts[cpu] = [
+            {"path": queue, "numEntries": int(ini[queue]["numEntries"]),
+             "fuPool": ini[queue]["fuPool"]}
+            for queue in queues
+        ]
+        capacities.add(tuple(row["numEntries"] for row in layouts[cpu]))
+    if len(capacities) != 1:
+        raise RuntimeError("business IQ capacities disagree")
+    roots = tuple(dict.fromkeys(row["fuPool"] + "." for row in layouts[cpus[0]]))
+    return sum(next(iter(capacities))), roots, layouts
+
+
+def import_refresh_timing(values, sources, dram, period):
+    """Refresh opt-in keeps its phase policy, but always uses this run's timer."""
+    if str(values.get("dram.refresh_enabled", "false")).lower() != "true":
+        return
+    for source, target in (("tREFI", "dram.t_refi_ticks"),
+                           ("tRFC", "dram.t_rfc_ticks")):
+        values[target] = dram[source]
+        sources[target] = dram.name + "." + source
+    values["dram.refresh_ticks_per_cycle"] = str(period)
+    sources["dram.refresh_ticks_per_cycle"] = "current gem5 business clock period ticks"
+
+
