new file mode 100644
index 0000000..a1b9f06
--- /dev/null
+++ b/tools/test_source_snapshot.py
@@ -0,0 +1,37 @@
+"""Snapshot simulator sources without walking unrelated experiment trees."""
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+from src.collection.gem5.runner import source_diff
+
+
+class SourceSnapshotTest(unittest.TestCase):
+    def test_scoped_untracked_sources_are_preserved(self):
+        temporary_root = ROOT / "tmp"
+        temporary_root.mkdir(exist_ok=True)
+        with tempfile.TemporaryDirectory(dir=temporary_root) as directory:
+            root = Path(directory)
+            def git(*args):
+                subprocess.run(["git", "-C", str(root), *args], check=True,
+                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+            git("init", "-q")
+            (root / "CMakeLists.txt").write_text("project(snapshot)\n")
+            git("add", "CMakeLists.txt")
+            git("-c", "user.name=fixture", "-c", "user.email=fixture@example.invalid",
+                "commit", "-qm", "fixture")
+            (root / "src").mkdir()
+            (root / "src/new.cpp").write_text("int value = 1;\n")
+            (root / "experiments").mkdir()
+            (root / "experiments/unrelated.bin").write_bytes(b"outside-source-scope")
+            diff = source_diff(root, source_paths=("CMakeLists.txt", "src"))
+            self.assertIn(b"src/new.cpp", diff)
+            self.assertNotIn(b"unrelated.bin", diff)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/test_spr_mapping.py b/tools/test_spr_mapping.py
new file mode 100644
index 0000000..f7822a6
--- /dev/null
+++ b/tools/test_spr_mapping.py
@@ -0,0 +1,55 @@
+"""Regression checks for the deployed SPR split queues and shared FU pool."""
+import configparser
+from pathlib import Path
+import sys
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from src.collection.gem5 import mapping
+
+
+class QueueMappingTest(unittest.TestCase):
+    def config(self, capacities=(128, 72, 48)):
+        ini = configparser.ConfigParser(interpolation=None)
+        ini.optionxform = str
+        for core in (1, 2):
+            cpu = f"cpu{core}"
+            queues = [f"{cpu}.iq{n}" for n in range(len(capacities))]
+            ini[cpu] = {"instQueues": " ".join(queues)}
+            for queue, size in zip(queues, capacities):
+                ini[queue] = {"numEntries": str(size), "fuPool": f"{cpu}.sharedFU"}
+        return ini
+
+    def test_split_queues_keep_capacity_and_do_not_duplicate_shared_fu(self):
+        entries, roots, layout = mapping.queue_layout(self.config(), ["cpu1", "cpu2"])
+        self.assertEqual(entries, 248)
+        self.assertEqual(roots, ("cpu1.sharedFU.",))
+        self.assertEqual([q["numEntries"] for q in layout["cpu1"]], [128, 72, 48])
+
+    def test_legacy_single_queue(self):
+        entries, roots, _ = mapping.queue_layout(self.config((160,)), ["cpu1", "cpu2"])
+        self.assertEqual(entries, 160)
+        self.assertEqual(roots, ("cpu1.sharedFU.",))
+
+    def test_heterogeneous_queues_fail_closed(self):
+        ini = self.config()
+        ini["cpu2.iq1"]["numEntries"] = "71"
+        with self.assertRaisesRegex(RuntimeError, "IQ capacities disagree"):
+            mapping.queue_layout(ini, ["cpu1", "cpu2"])
+
+    def test_refresh_uses_actual_run_instead_of_frozen_reference_values(self):
+        ini = configparser.ConfigParser(interpolation=None)
+        ini.optionxform = str
+        ini["native.dram"] = {"tREFI": "3900000", "tRFC": "295000"}
+        values = {"dram.refresh_enabled": "true", "dram.t_refi_ticks": "7800000",
+                  "dram.refresh_start_tick": "0"}
+        sources = {}
+        mapping.import_refresh_timing(values, sources, ini["native.dram"], 385)
+        self.assertEqual(values["dram.t_refi_ticks"], "3900000")
+        self.assertEqual(values["dram.t_rfc_ticks"], "295000")
+        self.assertEqual(values["dram.refresh_ticks_per_cycle"], "385")
+        self.assertEqual(sources["dram.t_refi_ticks"], "native.dram.tREFI")
+
+
+if __name__ == "__main__":
+    unittest.main()
