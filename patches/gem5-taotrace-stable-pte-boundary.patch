+            "TaoTrace source ROI checkpoint captured a zero guest CR3");
+    }
+    tc->getSystemPtr()->setSourceRoiAddressSpaceId(root);
+    inform("TaoTrace: source ROI checkpoint captured guest PTE root=%#lx",
+           (unsigned long)root);
