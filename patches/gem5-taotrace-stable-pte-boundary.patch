+TaoTrace::traceSourceRoiCheckpoint(gem5::ThreadContext *tc)
+{
+    if (!tc || !tc->getSystemPtr()) return;
+    X86ISA::Efer efer =
+        tc->readMiscRegNoEffect(X86ISA::misc_reg::Efer);
