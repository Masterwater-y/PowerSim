+            "ftq_wait_cycles",
+            "no_good_addr_cycles",
+        )
+
+        def validate_frontend(label, item):
+            checks = {
+                "request_population_conserved": (
+                    int(item["inflight_at_start"])
+                    + int(item["requests_started"])
+                    == sum(int(item[field]) for field in terminal_fields)
+                    + int(item["inflight_at_end"])
+                ),
+                "request_mode_conserved": (
+                    int(item["requests_started"])
+                    == int(item["user_mode_requests_started"])
+                    + int(item["kernel_mode_requests_started"])
+                ),
+                "request_reason_conserved": (
+                    int(item["requests_started"])
+                    == int(item["invalid_same_block_refetches"])
+                    + int(item["invalid_new_block_requests"])
+                    + int(item["valid_block_changes"])
+                ),
+                "send_accounting_conserved": (
+                    int(item["icache_send_attempts"])
+                    == int(item["icache_requests_sent"])
+                    + int(item["icache_send_rejects"])
+                ),
+            }
+            if int(item["status_cycle_samples"]) != sum(
+                int(item[field]) for field in status_fields
+            ):
+                raise SystemExit(
+                    f"kernel-events {label} frontend status cycles do not "
+                    "conserve"
+                )
+            for field, expected_value in checks.items():
+                if not expected_value or item.get(field) is not True:
+                    raise SystemExit(
+                        f"kernel-events {label} frontend does not conserve "
+                        f"{field}"
+                    )
+
+        for row, item in zip(per_core, frontend_rows):
+            validate_frontend(f"core {row['core_id']}", item)
+        for field in (
+            "request_population_conserved",
+            "request_mode_conserved",
+            "request_reason_conserved",
+            "send_accounting_conserved",
+        ):
+            frontend_aggregate[field] = True
+        validate_frontend("aggregate", frontend_aggregate)
+        frontend_aggregate["status_sample_minus_measured_cycles"] = (
+            int(frontend_aggregate["status_cycle_samples"])
+            - int(aggregate["measured_cycles"])
+        )
+        aggregate["frontend_accounting"] = frontend_aggregate
     active_kernel_pmu_classes = tuple(
         name for name in kernel_pmu_classes if name != "idle"
     )
