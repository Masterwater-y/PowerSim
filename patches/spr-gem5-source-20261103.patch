index 0000000000..5d2d3c60b7
--- /dev/null
+++ b/configs/fastsim/collection.py
@@ -0,0 +1,177 @@
+"""Retired collection policy; native SPR timing objects are read, never tuned."""
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+
+def parse_args(argv=None):
+    p = argparse.ArgumentParser(description="Native SPR retired-stream FS capture")
+    p.add_argument("--fastsim-root", type=Path, required=True)
+    p.add_argument("--workload-binary", required=True)
+    p.add_argument("--workload-args", default="")
+    p.add_argument("--participant-cores", "--omp-threads", dest="omp_threads", type=int, required=True)
+    p.add_argument("--extra-cores", type=int, default=0)
+    p.add_argument("--functional-user-target", type=int, default=10000000)
+    p.add_argument("--functional-sync", action="store_true")
+    p.add_argument("--thread-state", action="store_true")
+    p.add_argument("--scheduler-profile", type=Path)
+    p.add_argument("--sync-initial-context", choices=("empty", "unknown"), default="unknown")
+    kernel = p.add_mutually_exclusive_group()
+    kernel.add_argument("--kernel", type=Path, help="local gem5-compatible kernel ELF")
+    kernel.add_argument("--kernel-resource", default="x86-linux-kernel-5.4.49")
+    disk = p.add_mutually_exclusive_group()
+    disk.add_argument("--disk", type=Path, help="local raw guest disk image")
+    disk.add_argument("--disk-resource", default="x86-ubuntu-18.04-img")
+    p.add_argument("--disk-root-partition", default="1")
+    p.add_argument("--input-file", action="append", default=[])
+    p.add_argument("--input-archive", action="append", default=[])
+    p.add_argument("--staging-size", choices=("512m", "1g", "2g"), default="512m")
+    p.add_argument("--prepare-workload-args", default="")
+    p.add_argument("--rate-copies", type=int, default=0)
+    p.add_argument("--native-workers", type=int, default=0)
+    p.add_argument("--native-omp-num-threads", action="store_true")
+    p.add_argument("--native-warmup-after-identities", action="store_true")
+    p.add_argument("--rate-launcher", type=Path)
+    p.add_argument("--rate-private-cwd", action="store_true")
+    p.add_argument("--rate-serial-init", action="store_true")
+    p.add_argument("--housekeeping-cpu", type=int)
+    p.add_argument("--warmup-insts", type=int, default=0)
+    p.add_argument("--warmup-steps", type=int)
+    p.add_argument("--omp-proc-bind", default="")
+    p.add_argument("--omp-places", default="")
+    p.add_argument("--omp-wait-policy", choices=("", "ACTIVE", "PASSIVE"), default="")
+    p.add_argument("--skip-workload-validation", action="store_true")
+    p.add_argument("--trace-subdir", default="tao_trace")
+    p.add_argument("--max-ticks", type=int, default=0)
+    p.add_argument("--kvm-quantum-us", type=float, default=1000)
+    # Donor workload helpers consume these protocol options. Reusing old staged
+    # checkpoints with a different target would require a new identity contract.
+    p.set_defaults(checkpoint_phase="staged", save_boot_checkpoint=None,
+                   restore_boot_checkpoint=None, checkpoint_only=False,
+                   trace_format="fst", functional_include_kernel=True,
+                   functional_syscall_microops=True, functional_frontend=True,
+                   functional_retirement=True, clk="2.6GHz", mem_size="2GiB",
+                   mem_channels=16)
+    return p.parse_args(argv)
+
+
+def validate_options(args):
+    if args.omp_threads <= 0 or args.extra_cores < 0:
+        raise ValueError("participant count must be positive and spare count nonnegative")
+    if args.functional_user_target <= 0 or args.warmup_insts < 0 or args.max_ticks < 0:
+        raise ValueError("common-end target must be positive; warmup/tick limits nonnegative")
+    if args.kvm_quantum_us <= 0:
+        raise ValueError("KVM quantum must be positive")
+    if args.thread_state and not args.scheduler_profile:
+        raise ValueError("--thread-state requires --scheduler-profile with an exact audited kernel")
+    if args.scheduler_profile and not args.thread_state:
+        raise ValueError("--scheduler-profile requires --thread-state")
+    trace = Path(args.trace_subdir)
+    if trace.is_absolute() or ".." in trace.parts or not trace.parts:
+        raise ValueError("trace subdirectory must stay inside the output directory")
+
+
+def participant_ids(args):
+    return list(range(args.omp_threads))
+
+
+def load_donor(root):
+    root = Path(root).resolve()
+    path = root / "scripts/run_gem5_sync_probe.py"
+    if not path.is_file() or not (root / "tools/generate_guest_scheduler_profile.py").is_file():
+        raise ValueError("--fastsim-root does not contain the maintained collection helpers")
+    sys.path.insert(0, str(root / "tools"))
+    spec = importlib.util.spec_from_file_location("fastsim_legacy_collection_helpers", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def trace_options(args, trace_dir, profile_path, identity, thread_params=None):
+    return dict(
+        output_dir=str(trace_dir), uarch_profile_path=str(profile_path),
+        emit_micro=True, emit_macro=False, emit_mem_events=False,
+        require_roi=False, measure_cpl=True, trace_format="fst",
+        functional_include_kernel=True, functional_syscall_microops=True,
+        functional_frontend=True, functional_retirement=True,
+        functional_warmup=True, functional_user_target=args.functional_user_target,
+        functional_sync_marker_pc=identity.get("marker_pc", 0),
+        functional_sync_initial_context=args.sync_initial_context,
+        **(thread_params or {}),
+    )
+
+
+def attach_traces(cpus, trace_class, options):
+    for cpu in cpus:
+        cpu.tao_trace = trace_class(manager=cpu, **options)
+
+
+def native_profile(cpu, cache, memory, num_cores):
+    """Read incorporated native objects, including real bank and fill geometry.
+
+    The legacy observer profile is a diagnostic shadow; it does not represent
+    Ruby/SLICC native cache truth or provide target timing inputs.
+    """
+    def cache_row(obj, banks=1):
+        policy = {"LRURP": "lru", "TreePLRURP": "tree_plru"}.get(obj.replacement_policy.type)
+        if policy is None:
+            raise ValueError("unsupported observer replacement policy: " + obj.replacement_policy.type)
+        return dict(size_b=int(obj.size) * banks, assoc=int(obj.assoc), line_b=64,
+                    num_banks=banks, bank_select_low_bit=6, policy=policy)
+
+    def tlb_row(obj, ways_name=None):
+        size = int(obj.size)
+        ways = int(getattr(obj, ways_name)) if ways_name else 0
+        return dict(entries=size, assoc=ways or size)
+
+    l1 = cache._l1_controllers[0]
+    l2 = cache._l2_controllers[0]
+    l3 = cache._l3_controllers[0]
+    banks = len(cache._l3_controllers)
+    dram = memory.get_memory_controllers()[0].dram
+    profile = dict(
+        schema_version=2,
+        source="native SPR live SimObjects; legacy observer shadow, not native cache truth",
+        core=dict(isa="X86", num_cores=num_cores, freq_ghz=2.6,
+                  sq_entries=int(cpu.SQEntries)),
+        cache=dict(l1d=cache_row(l1.Dcache), l1i=cache_row(l1.Icache),
+                   l2=cache_row(l2.cache), l3=cache_row(l3.L2cache, banks)),
+        tlb=dict(dtlb=tlb_row(cpu.mmu.dtb, "dtlb_4k_ways"),
+                 itlb=tlb_row(cpu.mmu.itb, "itlb_4k_ways"), stlb=tlb_row(cpu.mmu.stlb)),
+        page_walker=dict(levels=4, page_size_bits=12, walk_attaches_to="sequencer", pwc_entries=0),
+        mshr=dict(l1d_entries=int(l1.Dcache.fill_capacity),
+                  l2_entries=int(l2.cache.fill_capacity), l3_entries=int(l3.number_of_TBEs)),
+        coherence=dict(protocol="MESI_Three_Level"),
+        dram=dict(model=dram.type, size_b=int(memory.get_size()),
+                  num_channels=len(memory.get_memory_controllers()),
+                  banks_per_channel=int(dram.banks_per_rank) * int(dram.ranks_per_channel),
+                  row_size_b=int(dram.device_rowbuffer_size) * int(dram.devices_per_rank),
+                  burst_b=64, interleaving_size_b=64,
+                  queue_window=int(dram.read_buffer_size)),
+    )
+    profile["observer_limitations"] = {
+        "cache_fields": "legacy observer shadow; native truth requires conserved Ruby/SLICC summaries",
+        "mshr_fields": "L1/L2 native data-fill credits; LLC native TBE budget",
+        "page_walker": "x86 four-level 4KiB shadow, not complete native walk/cache identity",
+    }
+    profile["native_cpu"] = {
+        name: int(getattr(cpu, name)) for name in (
+            "fetchWidth", "decodeWidth", "renameWidth", "dispatchWidth", "issueWidth",
+            "wbWidth", "commitWidth", "numROBEntries", "LQEntries", "SQEntries")}
+    profile["native_cpu"]["iq_entries"] = [int(iq.numEntries) for iq in cpu.instQueues]
+    return profile
+
+
+def write_profile(path, cpu, cache, memory, num_cores):
+    Path(path).write_text(json.dumps(native_profile(cpu, cache, memory, num_cores), indent=2) + "\n")
diff --git a/configs/fastsim/fs_capture.py b/configs/fastsim/fs_capture.py
new file mode 100644
index 0000000000..b8df30cd8f
--- /dev/null
+++ b/configs/fastsim/fs_capture.py
@@ -0,0 +1,200 @@
+"""Native SPR FS capture using legacy workload markers and a shared common end."""
+import json
+from pathlib import Path
+import sys
+import time
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from collection import (
+    attach_traces, load_donor, parse_args, participant_ids, sha256,
+    trace_options, validate_options, write_profile,
+)
+
+
+def main():
+    args = parse_args()
+    validate_options(args)
+    # Imports are delayed so policy tests and --help work without gem5.
+    import m5
+    from m5.objects import TaoTrace
+    from gem5.components.boards.x86_board import X86Board
+    from gem5.components.cachehierarchies.ruby.mesi_three_level_cache_hierarchy import SPRCacheHierarchy
+    from gem5.components.memory.dram_interfaces.ddr5 import DDR5_4400_4x8
+    from gem5.components.memory.memory import ChanneledMemory
+    from gem5.components.processors.cpu_types import CPUTypes
+    from gem5.components.processors.simple_switchable_processor import SimpleSwitchableProcessor
+    from gem5.isas import ISA
+    from gem5.resources.resource import DiskImageResource, KernelResource, obtain_resource
+    from gem5.simulate.exit_event import ExitEvent
+    from gem5.simulate.simulator import Simulator
+
+    donor = load_donor(args.fastsim_root)
+    donor.validate_rate_options(args)
+    identity = dict(binary=str(Path(args.workload_binary).resolve()),
+                    binary_sha256=sha256(args.workload_binary))
+    if args.functional_sync:
+        identity.update(donor.sync_binary_identity(args.workload_binary))
+    kernel = (KernelResource(local_path=str(args.kernel.resolve())) if args.kernel
+              else obtain_resource(args.kernel_resource))
+    disk = (DiskImageResource(local_path=str(args.disk.resolve()),
+                              root_partition=args.disk_root_partition) if args.disk
+            else obtain_resource(args.disk_resource))
+    thread_params, scheduler_identity = {}, None
+    if args.thread_state:
+        wait = donor.static_marker_identity(args.workload_binary, "fastsim_wait_marker",
+                                            "fastsim-wait-marker-v1", weak_only=True)
+        identity["thread_state_marker_pc"] = wait["marker_pc"]
+        identity["thread_state_marker_abi"] = wait["marker_abi"]
+        # Re-check actual kernel bytes and machine-code witnesses, never trust
+        # profile offsets alone. Unknown/host5.15 builds fail in this helper.
+        thread_params, scheduler_identity = donor.thread_state_profile(
+            args.scheduler_profile, kernel.get_local_path())
+        thread_params["thread_state_marker_pc"] = wait["marker_pc"]
+
+    outdir = Path(m5.options.outdir)
+    outdir.mkdir(parents=True, exist_ok=True)
+    trace_dir = outdir / args.trace_subdir
+    trace_dir.mkdir(parents=True, exist_ok=True)
+    profile_path = outdir / "uarch_profile.json"
+    num_cores = args.omp_threads + args.extra_cores
+
+    class CaptureProcessor(SimpleSwitchableProcessor):
+        def switch(self):
+            super().switch()
+            # Match the framework's KVM -> native detailed handoff: the O3
+            # cores use queue0, without periodic KVM quantum synchronization.
+            from _m5.event import enterSingleEventQueueMode
+            from m5.objects import Root
+            enterSingleEventQueueMode()
+            Root.getInstance().sim_quantum = 0
+
+        def _pre_instantiate(self, root):
+            super()._pre_instantiate(root)
+            root.sim_quantum = m5.ticks.fromSeconds(args.kvm_quantum_us * 1e-6)
+            # Board incorporation has created the actual Ruby controllers.
+            write_profile(profile_path, self._switchable_cores["switch"][0].get_simobject(),
+                          cache, memory, num_cores)
+
+    processor = CaptureProcessor(starting_core_type=CPUTypes.KVM,
+                                 switch_core_type=CPUTypes.O3,
+                                 num_cores=num_cores, isa=ISA.X86)
+    # Native CPU classes carry SPR frontend/allocation/partitioned-IQ/store
+    # behavior. No generic O3 setter belongs in this entry.
+    memory = ChanneledMemory(DDR5_4400_4x8, 16, 64, size="2GiB")
+    cache = SPRCacheHierarchy(l3_size="12MiB", l3_assoc=12, num_l3_banks=8)
+    board = X86Board(clk_freq="2.6GHz", processor=processor,
+                     memory=memory, cache_hierarchy=cache)
+    board.set_kernel_disk_workload(kernel=kernel, disk_image=disk,
+                                   readfile_contents=donor.boot_script(args),
+                                   exit_on_work_items=True)
+    traced = [wrapped.get_simobject() for wrapped in
+              processor._switchable_cores["switch"][:args.omp_threads]]
+    attach_traces(traced, TaoTrace,
+                  trace_options(args, trace_dir, profile_path, identity, thread_params))
+    from roi_capture_policy import BoundedWarmup
+    from spec_rate_checkpoint import RateCheckpointFlow
+    warmup = BoundedWarmup(args.warmup_insts,
+                           defer_until_identities=args.native_warmup_after_identities)
+    checkpoint_flow = RateCheckpointFlow("staged", False)
+    state = {"switched": False, "common_end": False, "measurement_open": False}
+
+    def milestone(phase):
+        with (outdir / "capture-phases.jsonl").open("a") as stream:
+            stream.write(json.dumps(dict(phase=phase, wall_time=time.time(),
+                                         tick=int(m5.curTick()))) + "\n")
+
+    def on_checkpoint():
+        if args.rate_copies:
+            action = checkpoint_flow.checkpoint()
+            if action in ("continue", "save"):
+                milestone("staged-before-fork")
+                return False
+        if not state["switched"]:
+            print("[fastsim-spr] CHECKPOINT marker: switch KVM -> O3+Ruby", flush=True)
+            milestone("switch-begin")
+            simulator.switch_processor()
+            state["switched"] = True
+            milestone("switch-complete")
+            if warmup.checkpoint() and args.warmup_insts:
+                traced[0].scheduleInstStopAnyThread(args.warmup_insts)
+        elif args.native_warmup_after_identities:
+            warmup.identities_ready()
+            milestone("native-identities-ready")
+            traced[0].scheduleInstStopAnyThread(args.warmup_insts)
+        return False
+
+    def on_workbegin():
+        # The workload emits both a work-item m5op and a serial marker. UART
+        # delivery may lag behind the m5op, and a work-item ID may be zero.
+        # Only the producers' actual functional boundary disambiguates them.
+        work_item = simulator.get_last_exit_event_code()
+        started = [cpu.tao_trace.functionalMeasurementStarted() for cpu in traced]
+        if not any(started):
+            print(f"[fastsim-spr] raw WORKBEGIN work-item {work_item}: notification only", flush=True)
+            milestone("raw-work-item-notification")
+            return False
+        if not all(started):
+            raise RuntimeError("inconsistent participant functional measurement state")
+        if state["measurement_open"]:
+            # A delayed raw work-item notification can arrive after the UART
+            # marker. Its code cannot prove a second serial marker occurred.
+            milestone("work-item-notification-after-measurement")
+            return False
+        if not state["switched"] or args.warmup_insts:
+            raise RuntimeError("unexpected workload WORKBEGIN outside switched marker mode")
+        state["measurement_open"] = True
+        print("[fastsim-spr] WORKBEGIN serial marker: measurement window open", flush=True)
+        # The serial terminal already invoked traceMeasurementBegin globally.
+        m5.stats.reset()
+        milestone("measurement-open")
+        return False
+
+    def on_max_insts():
+        if warmup.instruction_exit() == "open-measurement":
+            traced[0].tao_trace.startFunctionalMeasurement()
+            state["measurement_open"] = True
+            print("[fastsim-spr] WARMUP instruction budget reached: measurement window open", flush=True)
+            m5.stats.reset()
+            milestone("measurement-open")
+            return False
+        if not state["measurement_open"]:
+            raise RuntimeError("common-end instruction exit without an opened measurement")
+        state["common_end"] = True
+        print("[fastsim-spr] functional_user_target reached: common-end, finish", flush=True)
+        milestone("common-end")
+        return True
+
+    def on_exit():
+        milestone("guest-exit-before-common-end")
+        return True
+
+    simulator = Simulator(board=board, on_exit_event={
+        ExitEvent.CHECKPOINT: on_checkpoint, ExitEvent.WORKBEGIN: on_workbegin,
+        ExitEvent.MAX_INSTS: on_max_insts, ExitEvent.EXIT: on_exit,
+    })
+    request = dict(
+        schema="fastsim-spr-collection-request-v1", diagnostic=True,
+        participant_core_ids=participant_ids(args),
+        topology="legacy-capture: all guest CPUs are O3 after KVM handoff; no reserved Timing CPU0",
+        common_end="first-participant measured-user-UOP target closes every attached stream",
+        arguments={k: str(v) if isinstance(v, Path) else v for k, v in vars(args).items()},
+        binary_identity=identity, scheduler_identity=scheduler_identity,
+        kernel=dict(path=kernel.get_local_path(), sha256=sha256(kernel.get_local_path())),
+        disk=dict(path=disk.get_local_path(), root_partition=disk.get_root_partition()),
+        collector_helpers=dict(path=str(args.fastsim_root / "scripts/run_gem5_sync_probe.py"),
+                               sha256=sha256(args.fastsim_root / "scripts/run_gem5_sync_probe.py")),
+    )
+    (outdir / "sync-run-request.json").write_text(json.dumps(request, indent=2) + "\n")
+    print("[fastsim-spr] native SPR capture participants=" + str(participant_ids(args)), flush=True)
+    milestone("boot-start")
