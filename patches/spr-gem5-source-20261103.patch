-        for (unsigned i = 0; i < ages.size(); ++i) {
-            if (i != index)
-                maximum = std::max(maximum, ages[i]);
-        }
-        const uint8_t increment = 3 - maximum;
-        for (unsigned i = 0; i < ages.size(); ++i) {
-            if (i != index)
-                ages[i] += increment;
-        }
-    }
-
-  public:
