+        if name == "X86StoreAddress":
+            indices = (7, 8)
+        elif name == "X86StoreData":
+            indices = (4, 9)
+        elif name in reads:
+            indices = (2, 3, 10)
+        elif name in writes:
+            indices = (7, 8)
+        elif name == "IntAlu":
+            indices = (0, 1, 5, 6, 11)
+        elif name in {"IntMult", "FloatAdd", "SimdFloatAdd", "SimdMisc"}:
