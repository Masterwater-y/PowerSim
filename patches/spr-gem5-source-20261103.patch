+            if name in {"FloatDiv", "SimdFloatDiv"}:
+                desc.issueLat = 4 if name == "FloatDiv" else 3
+            ports[index].append(desc)
+    return FUPool(
+        FUList=[FUDesc(opList=ops, count=1) for ops in ports],
+        storeDataPorts=[4, 9], branchPorts=[0, 6],
+    )
