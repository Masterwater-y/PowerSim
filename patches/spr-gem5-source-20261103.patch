+        "SimdAlu": 1, "SimdAdd": 1, "SimdMisc": 1, "SimdCmp": 1,
+        "SimdShift": 1, "SimdMult": 3, "SimdFloatAdd": 2,
+        "SimdFloatMult": 4, "SimdFloatDiv": 11,
+    }
