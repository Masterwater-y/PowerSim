+#ifndef FASTSIM_FST_ARCHITECTURAL_BOUNDARIES_CODEC
+#define FASTSIM_FST_ARCHITECTURAL_BOUNDARIES_CODEC
+#include "fst_mmu_controls.hh"
+#include <map>
