+inline void validate(const Epoch &r) {
+  check(!(r.proof_flags & ~15u) && !(r.state_known & ~15u), "epoch masks");
+  for (unsigned i = 0; i < 4; ++i)
+    check((r.state_known & (1u << i)) || !r.state[i], "unknown epoch state");
