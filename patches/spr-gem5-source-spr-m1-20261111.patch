+        "accepted predecessor");
+  check((r.prefix_flags & 1)
+            ? r.prefix_begin < r.prefix_end && r.predecessor_kind == 1 &&
+                  r.prefix_end == r.predecessor_ordinal + 1
+            : r.prefix_begin == Absent && r.prefix_end == Absent &&
+                  !r.prefix_flags,
