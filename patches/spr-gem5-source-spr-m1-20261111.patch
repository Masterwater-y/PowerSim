+inline Bytes encode(const Accepted &r) {
+  validate(r);
+  auto b = prefix(2, 192);
+  put(b, std::uint64_t(r.event), 8);
+  put(b, std::uint64_t(r.context), 4);
+  put(b, std::uint64_t(r.generation), 4);
