+        write(&m,sizeof(m));frontend_hash_=frontend_hash(frontend_hash_,&m,sizeof(m));
+        le(unsigned(f.status),1);le(unsigned(f.reason),1);le(f.path_complete,1);le(f.fragments.size(),1);
+        if(version_==1)le(0,4);
