diff --git a/src/cpu/o3/probe/fst_static_uops.hh b/src/cpu/o3/probe/fst_static_uops.hh
new file mode 100644
index 0000000000..30998d96be
--- /dev/null
+++ b/src/cpu/o3/probe/fst_static_uops.hh
@@ -0,0 +1,110 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#include <zlib.h>
+namespace fastsim::fst {
+constexpr std::uint64_t kStaticUopFacts=1ull<<14;
+constexpr std::uint32_t kStaticExecutionKnown=1u<<0;
+constexpr std::uint32_t kStaticOperandRolesKnown=1u<<1;
+constexpr std::uint32_t kStaticAddressDataKnown=1u<<2;
+constexpr std::uint32_t kStaticStorePairKnown=1u<<3;
+constexpr std::uint32_t kStaticAbandonStoreGroups=1u<<4;
+constexpr std::uint32_t kStaticKnownFlags=31;
+enum class StaticStoreRole : std::uint8_t { None,Unified,Address,Data };
+struct StaticUopHeader {
+    std::array<char,8> magic{'F','S','T','U','O','P','1',0};
+    std::uint32_t version=1,header_size=64,core_id=0,row_size=64;
+    std::array<std::uint8_t,32> policy_sha256{};
+    std::uint64_t reserved=0;
+};
+struct StaticUopFactsRow {
+    std::uint64_t record_ordinal=0;
+    std::uint32_t hot_record_hash=0,flags=0;
+    std::uint64_t store_group=0,address_operands=0,data_operands=0;
+    std::uint16_t candidate_ports=0,nominal_latency=1,source_count=0,destination_count=0;
+    std::uint8_t integer_family=0,zero_idiom=0;
+    StaticStoreRole store_role=StaticStoreRole::None;
+    std::uint8_t reserved=0;
+    std::uint32_t operand_count=0;
+    std::uint64_t reserved2=0;
+};
+struct StaticUopOperand {
+    std::uint32_t producer_distance=0;
+    std::uint16_t consumer_operand=0;
+    std::uint8_t producer_role=5,reg_class=255; // native static role, never a ready time
+};
+struct StaticUopFooter {
+    std::array<char,8> magic{'F','S','T','U','E','N','D','1'};
+    std::uint64_t records=0,stream_hash=14695981039346656037ull;
+};
+static_assert(sizeof(StaticUopHeader)==64);
+static_assert(sizeof(StaticUopFactsRow)==64);
+static_assert(sizeof(StaticUopOperand)==8);
+static_assert(sizeof(StaticUopFooter)==24);
+inline std::uint64_t static_uop_stream_hash(std::uint64_t h,const void* record) {
+    const auto* b=static_cast<const unsigned char*>(record);
+    for(unsigned i=0;i<64;++i) h=(h^b[i])*1099511628211ull;
+    return h;
+}
+inline std::uint32_t static_uop_record_hash(const void* record) {
+    std::uint32_t h=2166136261u;const auto* b=static_cast<const unsigned char*>(record);
+    for(unsigned i=0;i<64;++i) h=(h^b[i])*16777619u;
+    return h;
+}
+inline void validate_static_uop(const StaticUopFactsRow& row,const std::vector<StaticUopOperand>& operands) {
+    if(row.flags&~kStaticKnownFlags || row.reserved || row.reserved2 || row.integer_family>5 || row.zero_idiom>4 ||
+       static_cast<unsigned>(row.store_role)>3 || row.candidate_ports>0xfff || !row.nominal_latency ||
+       row.operand_count!=operands.size() || row.source_count!=operands.size() || operands.size()>256)
+        throw std::runtime_error("invalid static UOP descriptor");
+    if((row.flags&kStaticExecutionKnown) && ((row.integer_family==0)!=(row.candidate_ports==0)))
+        throw std::runtime_error("static family/candidate policy contradiction");
+    if((row.flags&kStaticAddressDataKnown) && (row.source_count>64 ||
+       (row.source_count<64 && ((row.address_operands|row.data_operands)>>row.source_count))))
+        throw std::runtime_error("static address/data operand mask exceeds source count");
+    if((row.flags&kStaticStorePairKnown) && (row.store_role==StaticStoreRole::Address || row.store_role==StaticStoreRole::Data) && !row.store_group)
+        throw std::runtime_error("known split store pair lacks logical group");
+    if(row.store_role==StaticStoreRole::None && row.store_group)
+        throw std::runtime_error("nonstore UOP carries a store group");
+    for(std::size_t i=0;i<operands.size();++i) {
+        const auto& op=operands[i];
+        if(op.consumer_operand!=i || op.producer_distance>row.record_ordinal || op.producer_role>5 ||
+           (op.reg_class>3 && op.reg_class!=255) || (op.reg_class==255 && op.producer_distance))
+            throw std::runtime_error("invalid static UOP operand provenance");
+    }
+}
+// Header-only writer is shared verbatim with the independent native project.
+// One row per retained hot record; finish closes the compressed stream.
+class StaticUopWriter {
+    gzFile out_=nullptr;
+    std::uint64_t records_=0,hash_=14695981039346656037ull;
+    void write(const void* p,unsigned n) {
+        if(!out_ || gzwrite(out_,p,n)!=static_cast<int>(n)) throw std::runtime_error("static UOP companion write failed");
+    }
+public:
+    StaticUopWriter(const std::string& path,std::uint32_t core,const std::array<std::uint8_t,32>& policy) {
+        if(policy==std::array<std::uint8_t,32>{}) throw std::invalid_argument("static UOP source policy is undeclared");
+        out_=gzopen(path.c_str(),"wb1");if(!out_) throw std::runtime_error("cannot create static UOP companion");
+        StaticUopHeader h;h.core_id=core;h.policy_sha256=policy;write(&h,sizeof(h));
+    }
+    ~StaticUopWriter(){if(out_)gzclose(out_);}
+    void observe(const void* record,StaticUopFactsRow row,const std::vector<StaticUopOperand>& operands) {
+        row.record_ordinal=records_;row.hot_record_hash=static_uop_record_hash(record);
+        row.operand_count=static_cast<std::uint32_t>(operands.size());
+        validate_static_uop(row,operands);
+        write(&row,sizeof(row));
+        if(!operands.empty())write(operands.data(),static_cast<unsigned>(operands.size()*sizeof(StaticUopOperand)));
+        hash_=static_uop_stream_hash(hash_,record);++records_;
+    }
+    void finish(std::uint64_t records) {
+        if(!out_)return;
+        if(records!=records_)throw std::runtime_error("static UOP population mismatch");
+        StaticUopFooter f;f.records=records_;f.stream_hash=hash_;write(&f,sizeof(f));
+        const auto code=gzclose(out_);out_=nullptr;
+        if(code!=Z_OK)throw std::runtime_error("static UOP companion finalization failed");
+    }
+};
+} // namespace fastsim::fst
diff --git a/src/cpu/o3/probe/fst_store_requests.hh b/src/cpu/o3/probe/fst_store_requests.hh
new file mode 100644
index 0000000000..d62e1dca5c
--- /dev/null
+++ b/src/cpu/o3/probe/fst_store_requests.hh
@@ -0,0 +1,68 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+namespace fastsim::fst {
+// Functional facts for EVERY retired memory record, including reads. The .sreq
+// name is retained for the store-qualification extension. No native outcomes.
+// Version 1 request_flags use the gem5-spr Request::Flags layout (request.hh).
+constexpr std::uint64_t kStoreRequestFacts = 1ull << 13;
+enum StoreFactAttribute : std::uint32_t {
+    kStoreFactsComplete=1u<<0, kStoreOrdinary=1u<<1, kStoreNoAccess=1u<<2,
+    kStoreSplit=1u<<3, kStoreMasked=1u<<4, kStoreSecure=1u<<5,
+    kStoreAtomic=1u<<6, kStoreUncacheable=1u<<7, kStoreStrictlyOrdered=1u<<8,
+    kStoreHtm=1u<<9, kStoreSpecial=1u<<10,
+    kMemoryRead=1u<<11, kOrdinaryLoad=1u<<12,
+    kStorePagedFragments=1u<<13 // v2: PA identity is per bound .xlat fragment
+};
+constexpr std::uint32_t kKnownStoreAttributes=(1u<<14)-1;
+struct StoreRequestHeader {
+    std::array<char,8> magic{'F','S','T','S','R','E','Q','1'};
+    std::uint32_t version=1,header_size=56,core_id=0,flags=0;
+    std::uint64_t record_count=0,row_count=0,stream_hash=14695981039346656037ull;
+    std::uint32_t row_size=56,reserved=0;
+};
+struct StoreRequestFacts {
+    std::uint64_t record_ordinal=0;
+    std::uint32_t hot_record_hash=0,micro_pc=0;
+    std::uint64_t address=0,request_flags=0,byte_enable=0;
+    std::uint32_t size=0,attributes=0,context=0,requestor=0;
+};
+static_assert(sizeof(StoreRequestHeader)==56);
+static_assert(sizeof(StoreRequestFacts)==56);
+} // namespace fastsim::fst
+
+namespace fastsim::fst {
+// No inferred physical continuation across a virtual-page boundary. The
+// dynamic translation decoder separately validates mappings and stream hashes.
+template<class Fragments>
+bool paged_request_fragments_match(std::uint64_t address,std::uint32_t size,const Fragments& fragments) {
+    if(!size || size>64 || fragments.empty() || fragments.size()>2 || fragments.front().physical_address!=address)return false;
+    std::uint64_t covered=0;const auto base=fragments.front().virtual_address;
+    if(base>UINT64_MAX-(size-1))return false;
+    for(const auto& f:fragments) {
+        if(!f.size || f.size>size-covered || f.virtual_address!=base+covered ||
+           f.physical_address>UINT64_MAX-(f.size-1) || static_cast<unsigned>(f.mapping.kind)!=0 ||
+           !(f.mapping.flags&1) || f.mapping.address_space_id!=fragments.front().mapping.address_space_id ||
+           f.mapping.pcid!=fragments.front().mapping.pcid)return false;
+        covered+=f.size;
+    }
+    return covered==size;
+}
+template<class Fragments>
+bool paged_request_packet_matches(std::uint64_t va,std::uint64_t pa,std::uint32_t size,const Fragments& fragments) {
+    if(!size || va>UINT64_MAX-(size-1) || pa>UINT64_MAX-(size-1))return false;
+    std::uint64_t covered=0;
+    for(const auto& f:fragments) {
+        if(!f.size || f.virtual_address>UINT64_MAX-(f.size-1))return false;
+        const auto cursor=va+covered;
+        if(cursor<f.virtual_address || cursor-f.virtual_address>=f.size)continue;
+        const auto offset=cursor-f.virtual_address;
+        const auto part=std::min<std::uint64_t>(size-covered,f.size-offset);
+        if(f.physical_address>UINT64_MAX-offset || f.physical_address+offset!=pa+covered)return false;
+        covered+=part;
+        if(covered==size)return true;
+    }
+    return false;
+}
+} // namespace fastsim::fst
diff --git a/src/cpu/o3/probe/generate_static_uop_policy.py b/src/cpu/o3/probe/generate_static_uop_policy.py
new file mode 100644
index 0000000000..b554a558be
--- /dev/null
+++ b/src/cpu/o3/probe/generate_static_uop_policy.py
@@ -0,0 +1,73 @@
+"""Independent native build identity for static functional descriptor semantics."""
+import hashlib
+from pathlib import Path
+
+POLICY_FILES = (
+    'src/cpu/o3/probe/generate_static_uop_policy.py',
+    'src/cpu/o3/probe/fst_static_uops.hh',
+    'src/cpu/o3/probe/retired_frontend_facts.hh',
+    'src/cpu/o3/probe/TaoTrace.py',
+    'src/cpu/o3/probe/SConscript',
+    'taogen/shared/fst_instruction_fetch.hh',
+    'taogen/shared/fst_instruction_translations.hh',
+    'src/arch/x86/tlb.cc', 'src/arch/x86/tlb.hh',
+    'src/arch/x86/pagetable.cc', 'src/arch/x86/pagetable.hh',
+    'src/arch/x86/pagetable_walker.cc', 'src/arch/x86/pagetable_walker.hh',
+    'src/arch/x86/pcstate.hh',
+    'src/arch/generic/pcstate.hh', 'src/arch/generic/decoder.hh',
+    'src/cpu/o3/dyn_inst.cc', 'src/base/extensible.hh',
+    'src/arch/x86/isa.cc', 'src/arch/x86/mmu.hh',
+    'src/arch/x86/decoder.cc', 'src/arch/x86/decoder.hh',
+    'src/cpu/o3/fetch.cc', 'src/cpu/o3/fetch.hh',
+    'src/cpu/o3/frontend.cc', 'src/cpu/o3/frontend.hh',
+    'src/cpu/o3/frontend_fetch.cc',
+    'src/cpu/o3/frontend_record.cc', 'src/cpu/o3/frontend_record.hh',
+    'src/cpu/o3/cpu.hh', 'configs/fastsim/collection.py',
+    'src/cpu/o3/probe/fst_store_requests.hh',
+    'taogen/shared/fst_translation_facts.hh',
+    'taogen/shared/fst_dynamic_translation_writer.hh',
+    'src/cpu/o3/probe/tao_trace.cc',
+    'src/cpu/o3/probe/tao_trace.hh',
+    'src/cpu/static_inst.hh',
+    'src/cpu/static_inst.cc',
+    'src/cpu/StaticInstFlags.py',
+    'src/cpu/reg_class.hh',
+    'src/cpu/int_execution_info.hh',
+    'src/cpu/zero_idiom_info.hh',
+    'src/cpu/o3/dyn_inst.hh',
+    'src/cpu/o3/lsq_unit.hh',
+    'src/cpu/o3/lsq.hh',
+    'src/cpu/o3/lsq.cc',
+    'src/mem/request.hh',
+    'src/mem/functional_translation.hh',
+    'src/cpu/o3/lsq_unit.cc',
+)
+POLICY_TREES = ('src/arch/x86/isa', 'src/arch/x86/insts', 'src/arch/x86/regs')
+
+def policy_files(root):
+    root=Path(root)
+    files=set(POLICY_FILES)
+    for tree in POLICY_TREES:
+        directory=root/tree
+        if not directory.is_dir():
+            raise ValueError('missing static decoder source tree: '+str(directory))
+        for path in directory.rglob('*'):
+            if path.is_file() and path.suffix in ('.isa','.py','.hh','.cc'):
+                files.add(path.relative_to(root).as_posix())
+    return tuple(sorted(files))
+
+def policy_digest(root):
+    root = Path(root)
+    digest = hashlib.sha256(b'fst-static-uop-policy-v1\0')
+    for relative in policy_files(root):
+        blob = (root / relative).read_bytes()
+        digest.update(relative.encode() + b'\0')
+        digest.update(len(blob).to_bytes(8, 'little'))
+        digest.update(blob)
+    return digest.digest()
+
+def write_header(root, target):
+    literal = ','.join('0x%02x' % byte for byte in policy_digest(root))
+    Path(target).write_text('#pragma once\n#include <array>\n#include <cstdint>\n'
+        'namespace fastsim::fst { inline constexpr std::array<std::uint8_t,32> '
+        'kStaticUopPolicySha256{' + literal + '}; }\n')
