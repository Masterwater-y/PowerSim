+    <<"\"source\":\"BaseCPU::previousState/previousCycle\",\"sequence\":0,\"tick\":"<<epoch_tick_
+    <<",\"cycle\":"<<epoch_cycle_<<",\"previous_cycle\":"<<epoch_previous_
+    <<",\"previous_state\":"<<int(epoch_state_)<<",\"period\":"<<period_<<"},";
+  o<<"\"updates\":[";bool comma=false;
