+/** @brief Reusable production-thread barrier used by the gem5 ROI boundary. */
+struct gem5_roi_launch_gate
+{
+	pthread_mutex_t lock;
+	pthread_cond_t condition;
+	int target_count;
+	int arrived;
+	unsigned int phase;
+	bool creation_done;
+};
+
+static void gem5_roi_launch_gate_init(
+	gem5_roi_launch_gate* gate
+) {
+	pthread_mutex_init(&gate->lock, nullptr);
+	pthread_cond_init(&gate->condition, nullptr);
+	gate->target_count = 0;
+	gate->arrived = 0;
+	gate->phase = 0;
+	gate->creation_done = false;
+}
+
+static void gem5_roi_launch_gate_finish_creation(
+	gem5_roi_launch_gate* gate,
+	int target_count
+) {
+	pthread_mutex_lock(&gate->lock);
+	gate->target_count = target_count;
+	gate->creation_done = true;
+	pthread_cond_broadcast(&gate->condition);
+	pthread_mutex_unlock(&gate->lock);
+}
+
+static void gem5_roi_launch_gate_worker_ready(
+	gem5_roi_launch_gate* gate
+) {
+	pthread_mutex_lock(&gate->lock);
+	while (!gate->creation_done)
+	{
+		pthread_cond_wait(&gate->condition, &gate->lock);
+	}
+	pthread_mutex_unlock(&gate->lock);
+}
+
+static bool gem5_roi_launch_gate_barrier(
+	gem5_roi_launch_gate* gate
+) {
+	pthread_mutex_lock(&gate->lock);
+	unsigned int phase = gate->phase;
+	gate->arrived++;
+	bool leader = gate->arrived == gate->target_count;
+	if (leader)
+	{
+		gate->arrived = 0;
+		gate->phase++;
+		pthread_cond_broadcast(&gate->condition);
+	}
+	else
+	{
+		while (phase == gate->phase)
+		{
+			pthread_cond_wait(&gate->condition, &gate->lock);
+		}
+	}
+	pthread_mutex_unlock(&gate->lock);
+	return leader;
+}
+
+static void gem5_roi_launch_gate_destroy(
+	gem5_roi_launch_gate* gate
+) {
+	pthread_cond_destroy(&gate->condition);
+	pthread_mutex_destroy(&gate->lock);
+}
+
+static void gem5_roi_pin_worker(
+	int thread_id
+) {
+	cpu_set_t allowed;
+	int error = pthread_getaffinity_np(pthread_self(), sizeof(allowed), &allowed);
+	if (error)
+	{
+		fprintf(stderr, "ERROR: pthread_getaffinity_np failed: %d\n", error);
+		exit(EXIT_FAILURE);
+	}
+
+	int allowed_count = 0;
+	for (int cpu = 0; cpu < CPU_SETSIZE; cpu++)
+	{
+		allowed_count += CPU_ISSET(cpu, &allowed) ? 1 : 0;
+	}
+	if (!allowed_count)
+	{
+		fprintf(stderr, "ERROR: empty CPU affinity mask\n");
+		exit(EXIT_FAILURE);
+	}
+
+	int selected_index = thread_id % allowed_count;
+	int selected_cpu = -1;
+	for (int cpu = 0; cpu < CPU_SETSIZE; cpu++)
+	{
+		if (CPU_ISSET(cpu, &allowed) && selected_index-- == 0)
+		{
+			selected_cpu = cpu;
+			break;
+		}
+	}
+
+	cpu_set_t selected;
+	CPU_ZERO(&selected);
+	CPU_SET(selected_cpu, &selected);
+	error = pthread_setaffinity_np(pthread_self(), sizeof(selected), &selected);
+	if (error)
+	{
+		fprintf(stderr, "ERROR: pthread_setaffinity_np failed: %d\n", error);
+		exit(EXIT_FAILURE);
+	}
+}
