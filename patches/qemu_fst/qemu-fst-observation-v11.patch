+typedef struct qemu_fst_x86_state_view {
+    const uint64_t *fields;
+    uint16_t field_count;
+} qemu_fst_x86_state_view;
+
+typedef struct qemu_fst_x86_delta_view {
+    const uint64_t *bitmap;
+    const uint64_t *values;
+    uint16_t field_count;
+    uint16_t value_count;
+    uint64_t token;
+} qemu_fst_x86_delta_view;
