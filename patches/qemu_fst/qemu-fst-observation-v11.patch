+static uint32_t x86_plugin_segment_attributes(const SegmentCache *segment)
+{
+    return
+        ((segment->flags & DESC_TYPE_MASK) >> DESC_TYPE_SHIFT) |
+        (!!(segment->flags & DESC_S_MASK) << 4) |
+        (((segment->flags & DESC_DPL_MASK) >> DESC_DPL_SHIFT)
+         << QEMU_FST_X86_SEG_DPL_SHIFT) |
+        (!!(segment->flags & DESC_P_MASK) << 7) |
+        (!!(segment->flags & DESC_AVL_MASK) << 8) |
+        (!!(segment->flags & DESC_L_MASK) << 9) |
+        (!!(segment->flags & DESC_B_MASK) << 10) |
+        (!!(segment->flags & DESC_G_MASK) << 11);
+}
+
+static void
+x86_plugin_copy_segment(uint64_t *state, unsigned selector,
+                        unsigned base, unsigned limit, unsigned attributes,
+                        const SegmentCache *source)
+{
+    state[selector] = source->selector;
+    state[base] = source->base;
+    state[limit] = source->limit;
+    state[attributes] = x86_plugin_segment_attributes(source);
+}
+
+static bool
+x86_cpu_plugin_read_x86_state(
+    CPUState *cs, uint64_t *state)
+{
+    X86CPU *cpu = X86_CPU(cs);
+    CPUX86State *env = &cpu->env;
+
+    memset(state, 0,
+           QEMU_FST_X86_STATE_FIELD_COUNT * sizeof(*state));
+    for (unsigned i = 0; i < 16; ++i) {
+        state[QEMU_FST_X86_GPR_BASE + i] = env->regs[i];
+        state[QEMU_FST_X86_XMM_BASE + 2 * i] =
+            env->xmm_regs[i].ZMM_Q(0);
+        state[QEMU_FST_X86_XMM_BASE + 2 * i + 1] =
+            env->xmm_regs[i].ZMM_Q(1);
+    }
+    for (unsigned i = 0; i < 8; ++i) {
+        state[QEMU_FST_X86_FP80_BASE + 2 * i] = env->fpregs[i].d.low;
+        state[QEMU_FST_X86_FP80_BASE + 2 * i + 1] =
+            env->fpregs[i].d.high;
+    }
+    state[QEMU_FST_X86_MXCSR] = env->mxcsr;
+    state[QEMU_FST_X86_FCW] = env->fpuc;
+    state[QEMU_FST_X86_FSW] = env->fpus;
+    state[QEMU_FST_X86_X87_TOP] = env->fpstt;
+    for (unsigned i = 0; i < 8; ++i) {
+        state[QEMU_FST_X86_FTW] |= (!env->fptags[i]) << i;
+    }
+    state[QEMU_FST_X86_FOP] = env->fpop;
+    state[QEMU_FST_X86_FIP] = env->fpip;
+    state[QEMU_FST_X86_FDP] = env->fpdp;
+    state[QEMU_FST_X86_RFLAGS] = cpu_compute_eflags(env);
+    state[QEMU_FST_X86_CR0] = env->cr[0];
+    state[QEMU_FST_X86_CR2] = env->cr[2];
+    state[QEMU_FST_X86_CR3] = env->cr[3];
+    state[QEMU_FST_X86_CR4] = env->cr[4];
+#ifndef CONFIG_USER_ONLY
+    state[QEMU_FST_X86_CR8] = cpu_get_apic_tpr(cpu->apic_state);
+#endif
+    state[QEMU_FST_X86_EFER] = env->efer;
+#define COPY_SEGMENT(name, source) \
+    x86_plugin_copy_segment( \
+        state, QEMU_FST_X86_##name##_SELECTOR, \
+        QEMU_FST_X86_##name##_BASE, QEMU_FST_X86_##name##_LIMIT, \
+        QEMU_FST_X86_##name##_FLAGS, source)
+    COPY_SEGMENT(CS, &env->segs[R_CS]);
+    COPY_SEGMENT(SS, &env->segs[R_SS]);
+    COPY_SEGMENT(ES, &env->segs[R_ES]);
+    COPY_SEGMENT(DS, &env->segs[R_DS]);
+    COPY_SEGMENT(FS, &env->segs[R_FS]);
+    COPY_SEGMENT(GS, &env->segs[R_GS]);
+    COPY_SEGMENT(LDT, &env->ldt);
+    COPY_SEGMENT(TR, &env->tr);
+#undef COPY_SEGMENT
+    state[QEMU_FST_X86_GDT_BASE] = env->gdt.base;
+    state[QEMU_FST_X86_GDT_LIMIT] = env->gdt.limit;
+    state[QEMU_FST_X86_IDT_BASE] = env->idt.base;
+    state[QEMU_FST_X86_IDT_LIMIT] = env->idt.limit;
+    state[QEMU_FST_X86_STAR] = env->star;
+    state[QEMU_FST_X86_LSTAR] = env->lstar;
+    state[QEMU_FST_X86_CSTAR] = env->cstar;
+    state[QEMU_FST_X86_FMASK] = env->fmask;
+    state[QEMU_FST_X86_KERNEL_GS_BASE] = env->kernelgsbase;
+    state[QEMU_FST_X86_SYSENTER_CS] = env->sysenter_cs;
+    state[QEMU_FST_X86_SYSENTER_ESP] = env->sysenter_esp;
+    state[QEMU_FST_X86_SYSENTER_EIP] = env->sysenter_eip;
+    state[QEMU_FST_X86_TSC_AUX] = env->tsc_aux;
+    state[QEMU_FST_X86_CPL] = env->hflags & HF_CPL_MASK;
+    if (env->hflags & HF_SMM_MASK) {
+        return false;
+    }
+    return true;
+}
