+static uint32_t x86_plugin_segment_attributes(const SegmentCache *segment)
+{
+    return
+        ((segment->flags & DESC_TYPE_MASK) >> DESC_TYPE_SHIFT) |
+        (!!(segment->flags & DESC_S_MASK) << 4) |
+        (((segment->flags & DESC_DPL_MASK) >> DESC_DPL_SHIFT)
+         << QEMU_FST_X86_SEG_DPL_SHIFT) |
+        (!!(segment->flags & DESC_P_MASK) << 7) |
+        (!!(segment->flags & DESC_AVL_MASK) << 8) |
+        (!!(segment->flags & DESC_L_MASK) << 9) |
+        (!!(segment->flags & DESC_B_MASK) << 10) |
+        (!!(segment->flags & DESC_G_MASK) << 11);
+}
+
+static void
+x86_plugin_copy_segment(qemu_fst_x86_segment *destination,
+                        const SegmentCache *source)
+{
+    destination->selector = source->selector;
+    destination->limit = source->limit;
+    destination->attributes = x86_plugin_segment_attributes(source);
+    destination->base = source->base;
+}
+
+static bool
+x86_cpu_plugin_read_x86_state(
+    CPUState *cs, qemu_fst_x86_state *state)
+{
+    X86CPU *cpu = X86_CPU(cs);
+    CPUX86State *env = &cpu->env;
+
+    memset(state, 0, sizeof(*state));
+    for (unsigned i = 0; i < 16; ++i) {
+        state->gpr[i] = env->regs[i];
+        state->xmm[i][0] = env->xmm_regs[i].ZMM_Q(0);
+        state->xmm[i][1] = env->xmm_regs[i].ZMM_Q(1);
+    }
+    for (unsigned i = 0; i < 8; ++i) {
+        state->fpr[i][0] = env->fpregs[i].d.low;
+        state->fpr[i][1] = env->fpregs[i].d.high;
+        state->fptags[i] = env->fptags[i];
+    }
+    state->mxcsr = env->mxcsr;
+    state->fpuc = env->fpuc;
+    state->fpus = env->fpus;
+    state->fpstt = env->fpstt;
+    state->ftw = 0;
+    for (unsigned i = 0; i < 8; ++i) {
+        state->ftw |= (!env->fptags[i]) << i;
+    }
+    state->fpop = env->fpop;
+    state->fpip = env->fpip;
+    state->fpdp = env->fpdp;
+    state->rflags = cpu_compute_eflags(env);
+    state->cr0 = env->cr[0];
+    state->cr2 = env->cr[2];
+    state->cr3 = env->cr[3];
+    state->cr4 = env->cr[4];
+#ifndef CONFIG_USER_ONLY
+    state->cr8 = cpu_get_apic_tpr(cpu->apic_state);
+#endif
+    state->efer = env->efer;
+    x86_plugin_copy_segment(&state->cs, &env->segs[R_CS]);
+    x86_plugin_copy_segment(&state->ss, &env->segs[R_SS]);
+    x86_plugin_copy_segment(&state->es, &env->segs[R_ES]);
+    x86_plugin_copy_segment(&state->ds, &env->segs[R_DS]);
+    x86_plugin_copy_segment(&state->fs, &env->segs[R_FS]);
+    x86_plugin_copy_segment(&state->gs, &env->segs[R_GS]);
+    x86_plugin_copy_segment(&state->ldt, &env->ldt);
+    x86_plugin_copy_segment(&state->tr, &env->tr);
+    state->gdt_base = env->gdt.base;
+    state->gdt_limit = env->gdt.limit;
+    state->idt_base = env->idt.base;
+    state->idt_limit = env->idt.limit;
+    state->star = env->star;
+    state->lstar = env->lstar;
+    state->cstar = env->cstar;
+    state->fmask = env->fmask;
+    state->kernelgsbase = env->kernelgsbase;
+    state->sysenter_cs = env->sysenter_cs;
+    state->sysenter_esp = env->sysenter_esp;
+    state->sysenter_eip = env->sysenter_eip;
+    state->tsc_aux = env->tsc_aux;
+    state->cpl = env->hflags & HF_CPL_MASK;
+    state->smm = !!(env->hflags & HF_SMM_MASK);
+    return true;
+}
