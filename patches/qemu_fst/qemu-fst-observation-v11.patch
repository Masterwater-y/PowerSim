+    QEMU_FST_X86_SEG_LONG = 1 << 9,
+    QEMU_FST_X86_SEG_DEFAULT_SIZE = 1 << 10,
+    QEMU_FST_X86_SEG_GRANULARITY = 1 << 11,
+};
