+/*
+ * QEMU-FST read-only observation ABI.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef QEMU_FST_OBSERVATION_H
+#define QEMU_FST_OBSERVATION_H
+
+#include "qemu-plugin.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum qemu_fst_event_type {
+    QEMU_FST_EVENT_INTERRUPT = 1 << 0,
+    QEMU_FST_EVENT_EXCEPTION = 1 << 1,
+    QEMU_FST_EVENT_HOSTCALL = 1 << 2,
+    QEMU_FST_EVENT_SYSCALL = 1 << 3,
+    QEMU_FST_EVENT_ALL = -1,
+};
+
+enum qemu_fst_event_disposition {
+    QEMU_FST_EVENT_BETWEEN_INSTRUCTIONS,
+    QEMU_FST_EVENT_RETIRED_TRANSFER,
+    QEMU_FST_EVENT_UNRETIRED_FAULT,
+};
+
+typedef struct qemu_fst_observation_event {
+    enum qemu_fst_event_type type;
+    enum qemu_fst_event_disposition disposition;
+    uint64_t from_pc;
+    uint64_t to_pc;
+    uint32_t vector;
+    uint32_t error_code;
+    uint8_t vector_valid;
+    uint8_t error_code_valid;
+    uint8_t nested;
+    uint8_t reserved;
+} qemu_fst_observation_event;
+
+typedef void (*qemu_fst_vcpu_event_cb_t)(
+    qemu_plugin_id_t id, unsigned int vcpu_index,
+    const qemu_fst_observation_event *event);
+
+typedef void (*qemu_fst_vcpu_event_mem_cb_t)(
+    qemu_plugin_id_t id, unsigned int vcpu_index,
+    qemu_plugin_meminfo_t info, uint64_t vaddr,
+    bool supplemental, bool event_delivery);
+
+typedef void (*qemu_fst_vcpu_pio_cb_t)(
+    qemu_plugin_id_t id, unsigned int vcpu_index, uint16_t port,
+    unsigned int size, bool is_store, uint32_t value);
+
+typedef void (*qemu_fst_vcpu_macro_commit_cb_t)(
+    qemu_plugin_id_t id, unsigned int vcpu_index,
+    uint64_t pc, uint64_t successor);
+
+typedef void (*qemu_fst_vcpu_tsc_read_cb_t)(
+    qemu_plugin_id_t id, unsigned int vcpu_index, uint64_t value);
+
+typedef void (*qemu_fst_vcpu_tsc_aux_cb_t)(
+    qemu_plugin_id_t id, unsigned int vcpu_index, uint32_t value);
+
+QEMU_PLUGIN_API
+bool qemu_fst_x86_instruction_is_repeat(
+    const struct qemu_plugin_insn *insn);
+
+QEMU_PLUGIN_API
+bool qemu_fst_x86_instruction_is_pause(
+    const struct qemu_plugin_insn *insn);
+
+enum qemu_fst_x86_state_field {
