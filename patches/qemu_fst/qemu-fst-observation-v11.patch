+static bool
+qemu_fst_peek_x86_state(qemu_fst_x86_state_view *view)
+{
+    CPUClass *cc;
+    CPUPluginState *state;
+
+    g_assert(current_cpu);
+    g_assert(view);
+    if (qemu_plugin_get_cb_flags() == QEMU_PLUGIN_CB_NO_REGS) {
+        return false;
+    }
+    cc = CPU_GET_CLASS(current_cpu);
+    if (!cc->plugin_read_x86_state) {
+        return false;
+    }
+    state = current_cpu->plugin_state;
+    if (!state ||
+        !cc->plugin_read_x86_state(current_cpu, state->fst_peek_state)) {
+        return false;
+    }
+    *view = (qemu_fst_x86_state_view) {
+        .fields = state->fst_peek_state,
+        .field_count = QEMU_FST_X86_STATE_FIELD_COUNT,
+    };
+    return true;
+}
+
+static bool
+qemu_fst_stage_x86_delta(const qemu_fst_x86_state_view *view,
+                         qemu_fst_x86_delta_view *delta)
+{
+    CPUPluginState *state;
+    uint16_t value_count = 0;
+
+    g_assert(current_cpu);
+    g_assert(view);
+    g_assert(delta);
+    if (view->field_count != QEMU_FST_X86_STATE_FIELD_COUNT ||
+        !view->fields) {
+        return false;
+    }
+    state = current_cpu->plugin_state;
+    if (!state || state->fst_candidate_valid) {
+        return false;
+    }
+    state->fst_candidate_bitmap[0] = 0;
+    state->fst_candidate_bitmap[1] = 0;
+    memcpy(state->fst_candidate_state, view->fields,
+           sizeof(state->fst_candidate_state));
+    for (uint16_t index = 0;
+         index < QEMU_FST_X86_STATE_FIELD_COUNT; ++index) {
+        if (!state->fst_published_state_valid ||
+            view->fields[index] != state->fst_published_state[index]) {
+            state->fst_candidate_bitmap[index / 64] |=
+                UINT64_C(1) << (index % 64);
+            state->fst_candidate_values[value_count++] = view->fields[index];
+        }
+    }
+    state->fst_candidate_token = ++state->fst_next_token;
+    state->fst_candidate_valid = true;
+    *delta = (qemu_fst_x86_delta_view) {
+        .bitmap = state->fst_candidate_bitmap,
+        .values = state->fst_candidate_values,
+        .field_count = QEMU_FST_X86_STATE_FIELD_COUNT,
+        .value_count = value_count,
+        .token = state->fst_candidate_token,
+    };
+    return true;
+}
+
+static bool
+qemu_fst_commit_x86_delta(uint64_t token)
+{
+    CPUPluginState *state;
+
+    g_assert(current_cpu);
+    state = current_cpu->plugin_state;
+    if (!state || !state->fst_candidate_valid ||
+        token != state->fst_candidate_token) {
+        return false;
+    }
+    memcpy(state->fst_published_state, state->fst_candidate_state,
+           sizeof(state->fst_published_state));
+    state->fst_published_state_valid = true;
+    state->fst_candidate_valid = false;
+    return true;
+}
