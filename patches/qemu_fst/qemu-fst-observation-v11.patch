+void qemu_fst_observation_event_pre(
+    CPUState *cpu, enum qemu_fst_event_type type,
+    enum qemu_fst_event_disposition disposition, uint64_t from_pc,
+    uint32_t vector, bool vector_valid,
+    uint32_t error_code, bool error_code_valid)
+{
+    CPUPluginState *state = cpu->plugin_state;
+    enum qemu_plugin_event event;
+    enum qemu_plugin_event legacy_event = QEMU_PLUGIN_EV_MAX;
+
+    if (!state) {
+        return;
+    }
+    if (type & QEMU_FST_EVENT_INTERRUPT) {
+        event = QEMU_PLUGIN_EV_VCPU_INTERRUPT_EVENT;
+        legacy_event = QEMU_PLUGIN_EV_VCPU_INTERRUPT;
+    } else if (type & QEMU_FST_EVENT_EXCEPTION) {
+        event = QEMU_PLUGIN_EV_VCPU_EXCEPTION_EVENT;
+        legacy_event = QEMU_PLUGIN_EV_VCPU_EXCEPTION;
+    } else if (type & QEMU_FST_EVENT_SYSCALL) {
+        event = QEMU_PLUGIN_EV_VCPU_SYSCALL_EVENT;
+    } else {
+        event = QEMU_PLUGIN_EV_VCPU_HOSTCALL_EVENT;
+        legacy_event = QEMU_PLUGIN_EV_VCPU_HOSTCALL;
+    }
+    if (!test_bit(event, state->event_mask) &&
+        (legacy_event == QEMU_PLUGIN_EV_MAX ||
+         !test_bit(legacy_event, state->event_mask)) &&
+        !test_bit(QEMU_PLUGIN_EV_VCPU_EVENT_BEGIN, state->event_mask) &&
+        !test_bit(QEMU_PLUGIN_EV_VCPU_EVENT_MEM, state->event_mask)) {
+        return;
+    }
+    if (state->event_pending) {
+        error_report("plugin: nested vCPU event is not supported");
+        abort();
+    }
+    state->pending_event = (qemu_fst_observation_event) {
+        .type = type,
+        .disposition = disposition,
+        .from_pc = from_pc,
+        .vector = vector,
+        .error_code = error_code,
+        .vector_valid = vector_valid,
+        .error_code_valid = error_code_valid,
+    };
+    state->event_pending = true;
+    cpu->neg.plugin_event_mem_enabled =
+        test_bit(QEMU_PLUGIN_EV_VCPU_EVENT_MEM, state->event_mask);
+    plugin_vcpu_cb__event(
+        cpu, QEMU_PLUGIN_EV_VCPU_EVENT_BEGIN, &state->pending_event,
+        QEMU_PLUGIN_CB_R_REGS);
