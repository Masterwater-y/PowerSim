+static bool qemu_fst_observation_snapshot_ram(
+    CPUState *cpu, uint64_t vaddr, size_t size, int mmu_idx,
+    bool event_delivery)
+{
+    if (!cpu->plugin_state ||
+        !test_bit(QEMU_PLUGIN_EV_VCPU_EVENT_MEM,
+                  cpu->plugin_state->event_mask)) {
+        return true;
+    }
+    assert(cpu == current_cpu);
+    if (size == 0 || vaddr > UINT64_MAX - (size - 1)) {
+        return false;
+    }
+    CPUArchState *env = cpu_env(cpu);
+    while (size) {
+        hwaddr length = MIN(size, 16);
+        length = MIN(
+            length,
+            qemu_target_page_size() -
+                (vaddr & (qemu_target_page_size() - 1)));
+        void *host = NULL;
+        CPUTLBEntryFull *full = NULL;
+        const int flags = probe_access_full_mmu(
+            env, vaddr, length, MMU_DATA_LOAD, mmu_idx, &host, &full);
+        if (flags || !host || !full) {
+            return false;
+        }
+        unsigned shift = 0;
+        while (shift < 4 && (1U << (shift + 1)) <= length) {
+            ++shift;
+        }
+        const unsigned chunk = 1U << shift;
+        uint64_t low = 0, high = 0;
+        memcpy(&low, host, MIN(chunk, sizeof(low)));
+        if (chunk > sizeof(low)) {
+            memcpy(&high, (uint8_t *)host + sizeof(low),
+                   chunk - sizeof(low));
+        }
+        snapshot_hwaddr = (struct qemu_plugin_hwaddr) {
+            .phys_addr =
+                full->phys_addr | (vaddr & ~qemu_target_page_mask()),
+            .is_io = false,
+            .mr = NULL,
+        };
+        snapshot_vaddr = vaddr;
+        cpu->neg.plugin_mem_value_low = low;
+        cpu->neg.plugin_mem_value_high = high;
+        cpu->neg.plugin_event_mem_snapshot = true;
+        snapshot_active = true;
+        qemu_fst_observation_emit_mem(
+            cpu, make_plugin_meminfo(
+                     make_memop_idx((MemOp)(MO_LE | shift), mmu_idx),
+                     QEMU_PLUGIN_MEM_R),
+            vaddr, event_delivery);
+        snapshot_active = false;
+        cpu->neg.plugin_event_mem_snapshot = false;
+        vaddr += chunk;
+        size -= chunk;
+    }
+    return true;
+}
+
+bool qemu_fst_observation_event_input(
+    CPUState *cpu, uint64_t vaddr, size_t size, int mmu_idx)
+{
+    return qemu_fst_observation_snapshot_ram(
+        cpu, vaddr, size, mmu_idx, true);
+}
+
+bool qemu_fst_observation_frame_ram(
+    CPUState *cpu, uint64_t vaddr, size_t size, int mmu_idx)
+{
+    return qemu_fst_observation_snapshot_ram(
+        cpu, vaddr, size, mmu_idx, false);
+}
