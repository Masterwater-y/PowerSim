+    QEMU_FST_X86_FS_BASE = QEMU_FST_X86_RFLAGS + 1,
+    QEMU_FST_X86_GS_BASE = QEMU_FST_X86_FS_BASE + 1,
+    QEMU_FST_X86_CPL = QEMU_FST_X86_GS_BASE + 1,
+    QEMU_FST_X86_CR0 = QEMU_FST_X86_CPL + 1,
