+    QEMU_FST_X86_CR3 = QEMU_FST_X86_TR_FLAGS + 1,
+    QEMU_FST_X86_MXCSR = QEMU_FST_X86_CR3 + 1,
+    QEMU_FST_X86_ES_SELECTOR = QEMU_FST_X86_MXCSR + 1,
+    QEMU_FST_X86_ES_BASE = QEMU_FST_X86_ES_SELECTOR + 1,
+    QEMU_FST_X86_ES_LIMIT = QEMU_FST_X86_ES_BASE + 1,
+    QEMU_FST_X86_ES_FLAGS = QEMU_FST_X86_ES_LIMIT + 1,
