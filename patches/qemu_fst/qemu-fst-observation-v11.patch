+        qemu_fst_vcpu_event_cb_t cb);
+    void (*register_vcpu_event_mem_cb)(
+        qemu_plugin_id_t id, qemu_fst_vcpu_event_mem_cb_t cb);
+    bool (*peek_x86_state)(qemu_fst_x86_state_view *state);
+    bool (*stage_x86_delta)(
+        const qemu_fst_x86_state_view *state,
+        qemu_fst_x86_delta_view *delta);
+    bool (*commit_x86_delta)(uint64_t token);
+    void (*register_vcpu_pio_cb)(
+        qemu_plugin_id_t id, qemu_fst_vcpu_pio_cb_t cb);
+    void (*register_vcpu_macro_commit_cb)(
+        qemu_plugin_id_t id, qemu_fst_vcpu_macro_commit_cb_t cb);
+    void (*register_vcpu_tsc_read_cb)(
+        qemu_plugin_id_t id, qemu_fst_vcpu_tsc_read_cb_t cb);
+    void (*register_vcpu_tsc_aux_cb)(
+        qemu_plugin_id_t id, qemu_fst_vcpu_tsc_aux_cb_t cb);
+};
+
+typedef const struct qemu_fst_observation_api_v1 *
