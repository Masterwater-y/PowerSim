+#ifndef QEMU_TRACER_TRACE_ENTRY_EXTENSIONS_H
+#define QEMU_TRACER_TRACE_ENTRY_EXTENSIONS_H
+
+#include <cstdint>
+
+namespace qemu_trace_extensions {
+
+inline constexpr std::uint16_t kTraceTypeStateField = 54;
+
+inline constexpr std::uint16_t kMarkerRoiBoundary = 110;
+inline constexpr std::uint16_t kMarkerAddressSpace = 113;
+inline constexpr std::uint16_t kMarkerMemoryAttributes = 114;
+inline constexpr std::uint16_t kMarkerMemoryPhysicalAddress = 115;
+inline constexpr std::uint16_t kMarkerMacroBegin = 116;
+inline constexpr std::uint16_t kMarkerMacroCommit = 117;
