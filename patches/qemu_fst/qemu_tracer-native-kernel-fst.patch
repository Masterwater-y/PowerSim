+qemu_trace_extensions::StructuredEventKind
+eventKind(enum qemu_fst_event_type type)
+{
+    switch (type) {
+      case QEMU_FST_EVENT_INTERRUPT:
+        return qemu_trace_extensions::StructuredEventKind::kInterrupt;
+      case QEMU_FST_EVENT_EXCEPTION:
+        return qemu_trace_extensions::StructuredEventKind::kException;
+      case QEMU_FST_EVENT_HOSTCALL:
+        return qemu_trace_extensions::StructuredEventKind::kHostcall;
+      case QEMU_FST_EVENT_SYSCALL:
+        return qemu_trace_extensions::StructuredEventKind::kSyscall;
+      default:
+        LOG_FATAL("[native-fst] Unknown event type=%d.", int(type));
+    }
+}
+
+qemu_trace_extensions::StructuredEventDisposition
+eventDisposition(enum qemu_fst_event_disposition disposition)
+{
+    switch (disposition) {
+      case QEMU_FST_EVENT_BETWEEN_INSTRUCTIONS:
+        return qemu_trace_extensions::StructuredEventDisposition::
+            kBetweenInstructions;
+      case QEMU_FST_EVENT_RETIRED_TRANSFER:
+        return qemu_trace_extensions::StructuredEventDisposition::
+            kRetiredTransfer;
+      case QEMU_FST_EVENT_UNRETIRED_FAULT:
+        return qemu_trace_extensions::StructuredEventDisposition::
+            kUnretiredFault;
+      default:
+        LOG_FATAL("[native-fst] Unknown event disposition=%d.",
+                  int(disposition));
+    }
+}
