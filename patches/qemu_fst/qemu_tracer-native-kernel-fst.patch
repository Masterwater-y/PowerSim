+inline constexpr std::uint16_t kMarkerEventEnd = 120;
+inline constexpr std::uint16_t kMarkerVcpuState = 121;
+inline constexpr std::uint16_t kMarkerRawProtocol = 122;
+// Observed instruction inputs, not part of the Full/Delta pre-state chain.
+// These remain available when the completed instruction ends the raw window.
+inline constexpr std::uint16_t kMarkerTscRead = 123;
+inline constexpr std::uint16_t kMarkerTscAuxRead = 124;
+
+inline constexpr std::uint64_t kFileTypeQemuFstTransactional =
+    UINT64_C(1) << 62;
+
+inline constexpr std::uint16_t kRawAbiMajor = 1;
+inline constexpr std::uint16_t kRawAbiMajorShift = 48;
+inline constexpr std::uint64_t kRawAbiCapabilityMask =
+    (UINT64_C(1) << kRawAbiMajorShift) - 1;
+
+inline constexpr std::uint64_t kRawCapabilityTransactionalFraming =
+    UINT64_C(1) << 0;
+inline constexpr std::uint64_t kRawCapabilityBitmapDeltaState =
+    UINT64_C(1) << 1;
+inline constexpr std::uint64_t kRawCapabilityPhysicalMemory =
+    UINT64_C(1) << 2;
+inline constexpr std::uint64_t kRawCapabilityStructuredDiscontinuity =
+    UINT64_C(1) << 3;
+inline constexpr std::uint64_t kRawCapabilityRoiPhase =
+    UINT64_C(1) << 4;
+inline constexpr std::uint64_t kRawCapabilityVcpuIdleResume =
+    UINT64_C(1) << 5;
+inline constexpr std::uint64_t kRawCapabilityPio =
+    UINT64_C(1) << 6;
+inline constexpr std::uint64_t kRawCapabilityTscObservation =
+    UINT64_C(1) << 7;
+inline constexpr std::uint64_t kRawCapabilityFrameRam =
+    UINT64_C(1) << 8;
+
+inline constexpr std::uint64_t kRawRequiredCapabilities =
+    kRawCapabilityTransactionalFraming |
+    kRawCapabilityBitmapDeltaState |
+    kRawCapabilityPhysicalMemory |
+    kRawCapabilityStructuredDiscontinuity |
+    kRawCapabilityRoiPhase |
+    kRawCapabilityVcpuIdleResume |
+    kRawCapabilityFrameRam;
+
+inline constexpr std::uint64_t kRawProducerCapabilities =
+    kRawRequiredCapabilities |
+    kRawCapabilityPio |
+    kRawCapabilityTscObservation;
+
+inline constexpr std::uint64_t pack_raw_protocol(
+    std::uint16_t major, std::uint64_t capabilities)
+{
+    return (static_cast<std::uint64_t>(major) << kRawAbiMajorShift) |
+        (capabilities & kRawAbiCapabilityMask);
+}
+
+inline constexpr std::uint16_t raw_protocol_major(std::uint64_t payload)
+{
+    return static_cast<std::uint16_t>(payload >> kRawAbiMajorShift);
+}
+
+inline constexpr std::uint64_t raw_protocol_capabilities(
+    std::uint64_t payload)
+{
+    return payload & kRawAbiCapabilityMask;
+}
+
+inline constexpr std::uint16_t kStateValue = 0;
+inline constexpr std::uint16_t kStateBitmapLow = UINT16_MAX - 1;
+inline constexpr std::uint16_t kStateBitmapHigh = UINT16_MAX;
+
+inline constexpr std::uint32_t kSegmentTypeMask = 0xf;
+inline constexpr std::uint32_t kSegmentSystem = 1 << 4;
