diff --git a/common/qemu_fst_record.h b/common/qemu_fst_record.h
new file mode 100644
index 0000000..2d3486e
--- /dev/null
+++ b/common/qemu_fst_record.h
@@ -0,0 +1,120 @@
+#ifndef QEMU_TRACER_QEMU_FST_RECORD_H
+#define QEMU_TRACER_QEMU_FST_RECORD_H
+
+#include <cstddef>
+#include <cstdint>
+#include <type_traits>
+
+#include "trace_entry_extensions.h"
+
+namespace qemu_fst_record {
+
+inline constexpr std::uint64_t kMagic = UINT64_C(0x3257415244535446);
+inline constexpr std::uint32_t kVersion = 2;
+inline constexpr std::uint32_t kStateFieldCount =
+    qemu_trace_extensions::kStateFieldCount;
+
+enum class Kind : std::uint8_t {
+    RoiBegin = 1,
+    MeasurementBegin = 2,
+    Macro = 3,
+    Event = 4,
+    RoiEnd = 5,
+    Footer = 6,
+};
+
+enum class Phase : std::uint8_t {
+    Warmup = 0,
+    Measurement = 1,
+};
+
+enum HeaderFlags : std::uint32_t {
+    kHasTsc = 1U << 0,
+    kHasTscAux = 1U << 1,
+    kHasSyscallEvent = 1U << 2,
+};
+
+enum AccessFlags : std::uint8_t {
+    kAccessStore = 1U << 0,
+    kAccessPhysical = 1U << 1,
+    kAccessValue = 1U << 2,
+};
+
+struct Event {
+    qemu_trace_extensions::StructuredEventKind kind =
+        qemu_trace_extensions::StructuredEventKind::kInterrupt;
+    qemu_trace_extensions::StructuredEventDisposition disposition =
+        qemu_trace_extensions::StructuredEventDisposition::
+            kBetweenInstructions;
+    std::uint32_t vector = 0;
+    std::uint32_t errorCode = 0;
+    std::uint8_t vectorValid = 0;
+    std::uint8_t errorCodeValid = 0;
+    std::uint8_t reserved[6] = {};
+};
+
+struct alignas(16) FileHeader {
+    std::uint64_t magic = kMagic;
+    std::uint32_t version = kVersion;
+    std::uint32_t headerBytes = sizeof(FileHeader);
+    std::uint32_t coreId = 0;
+    std::uint32_t stateFieldCount = kStateFieldCount;
+    std::uint8_t reserved[24] = {};
+};
+
+struct alignas(16) Header {
+    std::uint32_t totalBytes = sizeof(Header);
+    Kind kind = Kind::RoiBegin;
+    Phase phase = Phase::Warmup;
+    std::uint8_t size = 0;
+    std::uint8_t reserved0 = 0;
+    std::uint16_t stateValueCount = 0;
+    std::uint16_t reserved1 = 0;
+    std::uint32_t accessCount = 0;
+    std::uint32_t flags = 0;
+    std::uint32_t tscAux = 0;
+    Event event;
+    std::uint64_t pc = 0;
+    std::uint64_t successor = 0;
+    std::uint64_t stateBitmap[2] = {};
+    std::uint64_t tsc = 0;
+    std::uint8_t bytes[16] = {};
+};
+
+struct alignas(16) Access {
+    std::uint64_t vaddr = 0;
+    std::uint64_t paddr = 0;
+    std::uint8_t value[16] = {};
+    std::uint32_t size = 0;
+    std::uint32_t attributes = 0;
+    std::uint8_t flags = 0;
+    std::uint8_t valueSize = 0;
+    std::uint8_t reserved[6] = {};
+
+    bool isStore() const { return flags & kAccessStore; }
+    bool hasPhysicalAddress() const { return flags & kAccessPhysical; }
+    bool hasValue() const { return flags & kAccessValue; }
+};
+
+inline constexpr std::size_t
+alignRecord(std::size_t bytes)
+{
+    return (bytes + 47) / 48 * 48;
+}
+
+static_assert(std::is_standard_layout_v<FileHeader>);
+static_assert(std::is_trivially_copyable_v<FileHeader>);
+static_assert(sizeof(FileHeader) == 48);
+static_assert(alignof(FileHeader) == 16);
+static_assert(std::is_standard_layout_v<Header>);
+static_assert(std::is_trivially_copyable_v<Header>);
+static_assert(sizeof(Header) == 112);
+static_assert(alignof(Header) == 16);
+static_assert(std::is_standard_layout_v<Access>);
+static_assert(std::is_trivially_copyable_v<Access>);
+static_assert(sizeof(Access) == 48);
+static_assert(alignof(Access) == 16);
+
+} // namespace qemu_fst_record
+
+#endif
