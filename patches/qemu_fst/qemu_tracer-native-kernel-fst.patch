+extern const qemu_fst_observation_api_v1 *observationApi;
+
+X86State
+captureX86State()
+{
+    static_assert(
+        qemu_trace_extensions::kStateFieldCount ==
+        QEMU_FST_X86_STATE_FIELD_COUNT);
+    qemu_fst_x86_state_view view{};
+    if (!observationApi || !observationApi->peek_x86_state(&view) ||
+        view.field_count != qemu_trace_extensions::kStateFieldCount) {
+        LOG_FATAL("[native-fst] x86 architectural state is unavailable.");
+    }
+    X86State state;
+    std::copy(
+        view.fields, view.fields + view.field_count, state.fields.begin());
+    const auto cpl =
+        state.fields[qemu_trace_extensions::kStateCpl];
+    if (cpl != 0 && cpl != 3) {
+        LOG_FATAL("[native-fst] Unsupported x86 privilege level %u.",
+                  unsigned(cpl));
+    }
+    if ((state.fields[qemu_trace_extensions::kStateCr3] &
+         ~UINT64_C(0xfff)) == 0) {
+        LOG_FATAL("[native-fst] x86 state has zero address-space identity.");
+    }
+    return state;
+}
+
+void
+resetGlobalCapturePhase()
+{
+    globalRoiStarted = false;
+    globalMeasurementStarted = false;
+    globalRoiEnded = false;
+    commonEndTriggerCore = std::numeric_limits<uint32_t>::max();
+}
+
+void
+publishGlobalRoiStart()
+{
+    if (globalRoiStarted.exchange(true)) {
+        LOG_FATAL("[native-fst] duplicate guest capture start.");
+    }
+}
+
+void
+publishGlobalMeasurementBegin()
+{
+    if (!globalRoiStarted.load() || globalRoiEnded.load() ||
+        globalMeasurementStarted.exchange(true)) {
+        LOG_FATAL("[native-fst] invalid guest measurement start.");
+    }
+}
+
+bool
+publishGlobalRoiEnd()
+{
+    if (!globalMeasurementStarted.load() || globalRoiEnded.exchange(true)) {
+        LOG_FATAL("[native-fst] invalid guest measurement end.");
+    }
+    return true;
+}
+
+bool
+globalRoiActive()
+{
+    return globalRoiStarted.load() && !globalRoiEnded.load();
+}
+
+bool
+globalCommonEndTriggered()
+{
+    return commonEndTriggerCore.load() !=
+        std::numeric_limits<uint32_t>::max();
+}
+
+uint32_t
+globalCommonEndTriggerCore()
+{
+    return commonEndTriggerCore.load();
+}
