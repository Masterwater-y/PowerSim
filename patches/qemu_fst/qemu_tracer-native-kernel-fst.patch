+
+    void measurementBegin()
+    {
+        phase = qemu_fst_record::Phase::Measurement;
+        writeControl(qemu_fst_record::Kind::MeasurementBegin);
+    }
+
+    void roiEnd()
+    {
+        writeControl(qemu_fst_record::Kind::RoiEnd);
+    }
+
+    void macro(const PendingMacro &macro, pc_t successor,
+               const qemu_fst_observation_event *syscallEvent = nullptr)
+    {
+        qemu_fst_record::Header header{};
+        header.kind = qemu_fst_record::Kind::Macro;
+        header.phase = phase;
+        header.size = macro.size;
+        header.pc = macro.pc;
+        header.successor = successor;
+        std::memcpy(header.bytes, macro.encoding.data(), macro.size);
+        if (macro.tsc) {
+            header.flags |= qemu_fst_record::kHasTsc;
+            header.tsc = *macro.tsc;
+        }
+        if (macro.tscAux) {
+            header.flags |= qemu_fst_record::kHasTscAux;
+            header.tscAux = *macro.tscAux;
+        }
+        if (syscallEvent) {
+            header.flags |= qemu_fst_record::kHasSyscallEvent;
+            setEvent(header, *syscallEvent);
+        }
+        writeRecord(header, macro.state, macro.accesses);
+    }
+
+    void event(const PendingEvent &pendingEvent)
+    {
+        const auto &event = pendingEvent.event;
+        qemu_fst_record::Header header{};
+        header.kind = qemu_fst_record::Kind::Event;
+        header.phase = phase;
+        header.pc = event.from_pc;
+        header.successor = event.to_pc;
+        setEvent(header, event);
+        writeRecord(header, pendingEvent.state, pendingEvent.accesses);
+    }
+
+    void finish()
+    {
+        writeControl(qemu_fst_record::Kind::Footer);
+        sync();
+        bufferManager->send_buffer(trace_buffer_t(nullptr, 0, windowId));
+    }
+
+  private:
+    static constexpr window_id_t windowId = 0;
+    static constexpr size_t transportUnit = sizeof(trace_entry_t);
+    static constexpr size_t maxBytes =
+        PER_BUFFER_SIZE / transportUnit * transportUnit;
+    const vcpu_id_t id;
+    std::shared_ptr<buffer_manager_t> bufferManager;
+    trace_entry_t *buffer = nullptr;
+    size_t usedBytes = 0;
+    qemu_fst_record::Phase phase = qemu_fst_record::Phase::Warmup;
+    std::vector<uint8_t> recordBytes;
+
+    void allocate()
+    {
+        buffer = bufferManager->alloc_buffer();
+        usedBytes = 0;
+    }
+
+    void sync()
+    {
+        if (!buffer || usedBytes == 0) {
+            return;
+        }
+        if (usedBytes % transportUnit != 0) {
+            LOG_FATAL("[native-fst] Raw byte stream is not transport aligned.");
+        }
+        bufferManager->send_buffer(trace_buffer_t(
+            buffer, usedBytes / transportUnit, windowId));
+        buffer = nullptr;
+        usedBytes = maxBytes;
+    }
+
+    void writeControl(qemu_fst_record::Kind kind)
+    {
+        qemu_fst_record::Header header{};
+        header.kind = kind;
+        header.phase = phase;
+        header.totalBytes =
+            qemu_fst_record::alignRecord(sizeof(header));
+        recordBytes.assign(header.totalBytes, 0);
+        std::memcpy(recordBytes.data(), &header, sizeof(header));
+        writeBytes(recordBytes.data(), recordBytes.size());
+    }
+
+    void writeBytes(const void *source, size_t bytes)
+    {
+        const auto *cursor = static_cast<const uint8_t *>(source);
+        while (bytes != 0) {
+            if (!buffer || usedBytes == maxBytes) {
+                sync();
+                allocate();
+            }
+            const size_t count = std::min(bytes, maxBytes - usedBytes);
+            std::memcpy(
+                reinterpret_cast<uint8_t *>(buffer) + usedBytes,
+                cursor, count);
+            usedBytes += count;
+            cursor += count;
+            bytes -= count;
+        }
+    }
+
+    static void setEvent(
+        qemu_fst_record::Header &header,
+        const qemu_fst_observation_event &event)
+    {
+        header.event.kind = eventKind(event.type);
+        header.event.disposition = eventDisposition(event.disposition);
+        header.event.vectorValid = event.vector_valid;
+        header.event.errorCodeValid = event.error_code_valid;
+        header.event.vector = event.vector;
+        header.event.errorCode = event.error_code;
+    }
+
+    static void
+    validateAccess(const qemu_fst_record::Access &access)
+    {
+        const bool pio =
+            access.attributes & qemu_trace_extensions::kMemoryAttributePio;
+        if (!pio && !access.hasPhysicalAddress()) {
+            LOG_FATAL("[native-fst] Memory fact has no physical address.");
+        }
+        if (access.size == 0 || access.size > 16) {
+            LOG_FATAL("[native-fst] Access size is outside 1..16 bytes.");
+        }
+        if (access.isStore() && access.hasValue()) {
+            LOG_FATAL("[native-fst] Store fact unexpectedly carries a value.");
+        }
+        if (!access.isStore() &&
+            (!access.hasValue() || access.valueSize != access.size)) {
+            LOG_FATAL("[native-fst] Load fact has incomplete value.");
+        }
+    }
+
+    void writeRecord(
+        qemu_fst_record::Header &header, const X86State &state,
+        const std::vector<qemu_fst_record::Access> &accesses)
+    {
+        qemu_fst_x86_state_view stateView{
+            state.fields.data(),
+            static_cast<uint16_t>(state.fields.size())};
+        qemu_fst_x86_delta_view delta{};
+        if (!observationApi->stage_x86_delta(&stateView, &delta) ||
+            delta.field_count != state.fields.size() || !delta.bitmap ||
+            (delta.value_count != 0 && !delta.values)) {
+            LOG_FATAL("[native-fst] Failed to stage x86 state delta.");
+        }
+        header.stateBitmap[0] = delta.bitmap[0];
+        header.stateBitmap[1] = delta.bitmap[1];
+        header.stateValueCount = delta.value_count;
+        if (accesses.size() > UINT32_MAX) {
+            LOG_FATAL("[native-fst] Access count exceeds uint32.");
+        }
+        header.accessCount = static_cast<uint32_t>(accesses.size());
+        const size_t payloadBytes =
+            static_cast<size_t>(delta.value_count) * sizeof(uint64_t) +
+            accesses.size() * sizeof(qemu_fst_record::Access);
+        const size_t totalBytes = qemu_fst_record::alignRecord(
+            sizeof(header) + payloadBytes);
+        if (totalBytes > UINT32_MAX) {
+            LOG_FATAL("[native-fst] Raw record exceeds uint32 size.");
+        }
+        header.totalBytes = static_cast<uint32_t>(totalBytes);
+        recordBytes.assign(header.totalBytes, 0);
+        size_t offset = 0;
+        std::memcpy(recordBytes.data() + offset, &header, sizeof(header));
+        offset += sizeof(header);
+        const size_t stateBytes =
+            static_cast<size_t>(delta.value_count) * sizeof(uint64_t);
+        if (stateBytes != 0) {
+            std::memcpy(
+                recordBytes.data() + offset, delta.values, stateBytes);
+            offset += stateBytes;
+        }
+        for (const auto &access : accesses) {
+            validateAccess(access);
+            std::memcpy(
+                recordBytes.data() + offset, &access, sizeof(access));
+            offset += sizeof(access);
+        }
+        writeBytes(recordBytes.data(), recordBytes.size());
+        if (!observationApi->commit_x86_delta(delta.token)) {
+            LOG_FATAL("[native-fst] Failed to commit x86 state delta.");
+        }
+    }
+};
+
+NativeFstSession::NativeFstSession(
+    vcpu_id_t id,
+    const std::shared_ptr<buffer_manager_t> &bufferManager,
+    const config_t &config)
+    : id(id), config(config), bufferManager(bufferManager)
+{
+}
+
+NativeFstSession::~NativeFstSession() = default;
+
+bool
+NativeFstSession::needsInstructionState() const
+{
+    return phase != CapturePhase::Complete && globalRoiStarted.load();
+}
+
+void
+NativeFstSession::start()
+{
+    if (writer) {
+        return;
+    }
+    writer = std::make_unique<RawWriter>(id, bufferManager);
+    writer->roiBegin();
+    phase = CapturePhase::Warmup;
+}
+
+void
+NativeFstSession::applyGlobalPhase(pc_t nextPc, bool discardPending)
+{
+    if (globalRoiStarted.load() && !sawGlobalStart) {
+        start();
+        sawGlobalStart = true;
+    }
+    if (globalMeasurementStarted.load() && !sawGlobalMeasurement) {
+        requestMeasurement(nextPc, discardPending);
+        sawGlobalMeasurement = true;
+    }
+    if (globalRoiEnded.load() && !sawGlobalEnd) {
+        finishRoi(nextPc, discardPending);
+        sawGlobalEnd = true;
+    }
+}
+
+void
+NativeFstSession::requestMeasurement(pc_t nextPc, bool discardPending)
+{
+    if (phase == CapturePhase::Measurement) {
+        return;
+    }
+    if (!writer || phase != CapturePhase::Warmup) {
+        LOG_FATAL("[native-fst] Measurement boundary has no active ROI.");
+    }
+    if (discardPending) {
+        discardPendingMacro();
+    }
+    writer->measurementBegin();
+    phase = CapturePhase::Measurement;
+    backend_signal_measurement_started();
+}
+
+void
+NativeFstSession::finishRoi(pc_t nextPc, bool discardPending)
+{
+    if (phase == CapturePhase::Complete) {
+        return;
+    }
+    if (!writer || phase == CapturePhase::BeforeRoi) {
+        LOG_FATAL("[native-fst] ROI end precedes ROI start.");
+    }
+    if (discardPending) {
+        discardPendingMacro();
+    }
+    if (measuredUserMacros < config.user_macro_target) {
+        LOG_FATAL(
+            "[native-fst] ROI ended before the capture target on vCPU %u "
+            "(%llu/%llu).", id,
+            static_cast<unsigned long long>(measuredUserMacros),
+            static_cast<unsigned long long>(config.user_macro_target));
+    }
+    event.reset();
+    writer->roiEnd();
+    writer->finish();
+    phase = CapturePhase::Complete;
+}
+
+void
+NativeFstSession::finishCommonEnd()
+{
+    if (phase == CapturePhase::Complete) {
+        return;
+    }
+    if (!writer || phase == CapturePhase::BeforeRoi) {
+        LOG_FATAL("[native-fst] common end precedes ROI start.");
+    }
+    discardPendingMacro();
+    event.reset();
+    writer->roiEnd();
+    writer->finish();
+    commonEndObserved = true;
+    phase = CapturePhase::Complete;
+}
+
+bool
+NativeFstSession::finishIfCommonEnd()
+{
+    if (!globalCommonEndTriggered() ||
+        phase == CapturePhase::BeforeRoi ||
+        phase == CapturePhase::Complete) {
+        return phase == CapturePhase::Complete;
+    }
+    finishCommonEnd();
+    return true;
+}
+
+bool
+NativeFstSession::commitMacro(
+    PendingMacro macro, pc_t successor,
+    const qemu_fst_observation_event *syscallEvent)
+{
+    if (successor == 0) {
+        return false;
+    }
+    const bool user =
+        macro.state.fields[qemu_trace_extensions::kStateCpl] == 3;
+    if (suppressIdleMacro(macro)) {
+        return false;
+    }
+    writer->macro(macro, successor, syscallEvent);
+    return user;
+}
+
+bool
+NativeFstSession::accountCommittedUser(bool committedUser)
+{
+    if (!committedUser || phase != CapturePhase::Measurement) {
+        return false;
+    }
+    ++measuredUserMacros;
+    uint32_t expected = std::numeric_limits<uint32_t>::max();
+    if (measuredUserMacros == config.user_macro_target &&
+        commonEndTriggerCore.compare_exchange_strong(
+            expected, static_cast<uint32_t>(id))) {
+        backend_signal_common_end(
+            static_cast<uint32_t>(id), config.user_macro_target);
+    }
+    if (!globalCommonEndTriggered()) {
+        return false;
+    }
+    finishCommonEnd();
+    return true;
+}
+
+bool
+NativeFstSession::instruction(
+    const inst_t &instruction, const X86State &state)
+{
+    ++instructionCount;
+    if (macro && phase != CapturePhase::BeforeRoi &&
+        phase != CapturePhase::Complete) {
+        if (commitPendingMacro(instruction.pc())) {
+            return true;
+        }
+    }
+    applyGlobalPhase(instruction.pc(), false);
+    if (finishIfCommonEnd()) {
+        return true;
+    }
+    if (phase == CapturePhase::BeforeRoi ||
+        phase == CapturePhase::Complete) {
+        return phase == CapturePhase::Complete;
+    }
+    if (event) {
+        LOG_FATAL("[native-fst] Instruction overlaps an open event.");
+    }
+    if (macro && macro->repeat && instruction.repeat() &&
+        macro->pc == instruction.pc()) {
+        return false;
+    }
+    PendingMacro pending;
+    pending.pc = instruction.pc();
+    pending.size = instruction.size();
+    std::memcpy(
+        pending.encoding.data(),
+        instruction.inst_code<const uint8_t *>(), pending.size);
+    pending.repeat = instruction.repeat();
+    pending.pause = instruction.pause();
+    pending.state = state;
+    pending.accesses.reserve(8);
+    macro = std::move(pending);
+    return false;
+}
+
+bool
+NativeFstSession::macroCommit(pc_t pc, pc_t successor)
+{
+    if (phase == CapturePhase::Complete) {
+        return true;
+    }
+    if (!macro || macro->pc != pc) {
+        LOG_FATAL("[native-fst] QEMU committed unknown macro pc=%#llx.",
+                  static_cast<unsigned long long>(pc));
+    }
+    const bool reached = commitPendingMacro(successor);
+    return reached;
+}
+
+void
+NativeFstSession::tscRead(uint64_t value)
+{
+    if (!macro) {
+        LOG_FATAL("[native-fst] QEMU TSC result has no open macro.");
+    }
+    if (macro->tsc) {
+        LOG_FATAL("[native-fst] QEMU macro has duplicate TSC result.");
+    }
+    macro->tsc = value;
+}
+
+void
+NativeFstSession::tscAuxRead(uint32_t value)
+{
+    if (!macro || !macro->tsc) {
+        LOG_FATAL("[native-fst] QEMU TSC_AUX result has no TSC result.");
+    }
+    if (macro->tscAux) {
+        LOG_FATAL("[native-fst] QEMU macro has duplicate TSC_AUX result.");
+    }
+    macro->tscAux = value;
+}
+
+void
+NativeFstSession::memory(const qemu_fst_record::Access &access)
+{
+    if (macro) {
+        macro->accesses.push_back(access);
+        return;
+    }
+    if (phase != CapturePhase::BeforeRoi &&
+        phase != CapturePhase::Complete) {
+        LOG_FATAL("[native-fst] Memory callback has no pending macro.");
+    }
+}
+
+void
+NativeFstSession::discardPendingMacro()
+{
+    macro.reset();
+}
+
+bool
+NativeFstSession::eventBegin(
+    const qemu_fst_observation_event &event, const X86State &state)
+{
+    if (globalRoiStarted.load() && !sawGlobalStart) {
+        start();
+        sawGlobalStart = true;
+    }
+    if (phase == CapturePhase::BeforeRoi ||
+        phase == CapturePhase::Complete) {
+        return phase == CapturePhase::Complete;
+    }
+    if (this->event) {
+        LOG_FATAL("[native-fst] Nested event on vCPU %u.", id);
+    }
+    if (macro) {
+        if (event.disposition == QEMU_FST_EVENT_BETWEEN_INSTRUCTIONS) {
+            if (macro->repeat) {
+                macro.reset();
+            } else if (commitPendingMacro(event.from_pc)) {
+                return true;
+            }
+        } else if (event.disposition == QEMU_FST_EVENT_UNRETIRED_FAULT) {
+            macro.reset();
+        }
+    }
+    applyGlobalPhase(event.from_pc, false);
+    if (phase == CapturePhase::Complete) {
+        return true;
+    }
+    resetPollIdle();
+    PendingEvent pendingEvent;
+    pendingEvent.event = event;
+    pendingEvent.state = state;
+    pendingEvent.accesses.reserve(16);
+    this->event = std::move(pendingEvent);
+    return false;
+}
+
+void
+NativeFstSession::eventMemory(const qemu_fst_record::Access &access)
+{
+    if (!event) {
+        if (phase != CapturePhase::Complete) {
+            LOG_FATAL("[native-fst] Event memory has no pending event.");
+        }
+        return;
+    }
+    event->accesses.push_back(access);
+}
+
+bool
+NativeFstSession::eventEnd(const qemu_fst_observation_event &event)
+{
+    if (phase == CapturePhase::Complete) {
+        return true;
+    }
+    if (!this->event) {
+        return phase == CapturePhase::Complete;
+    }
+    if (this->event->event.type != event.type ||
+        this->event->event.disposition != event.disposition ||
+        this->event->event.from_pc != event.from_pc ||
+        this->event->event.vector != event.vector ||
+        this->event->event.vector_valid != event.vector_valid ||
+        this->event->event.error_code != event.error_code ||
+        this->event->event.error_code_valid != event.error_code_valid) {
+        LOG_FATAL("[native-fst] Event begin/end mismatch.");
+    }
+    if (event.nested) {
+        LOG_FATAL("[native-fst] Nested event is unsupported.");
+    }
+    if ((event.type == QEMU_FST_EVENT_INTERRUPT ||
+         event.type == QEMU_FST_EVENT_EXCEPTION) &&
+        !event.vector_valid) {
+        LOG_FATAL("[native-fst] Interrupt/exception has no vector.");
+    }
+    bool committedUser = false;
+    if (event.disposition == QEMU_FST_EVENT_RETIRED_TRANSFER) {
+        if (!macro || macro->pc != event.from_pc) {
+            LOG_FATAL(
+                "[native-fst] Retired-transfer event has no matching macro.");
+        }
+        const auto *syscall =
+            event.type == QEMU_FST_EVENT_SYSCALL ? &event : nullptr;
+        PendingMacro completedMacro = std::move(*macro);
+        macro.reset();
+        committedUser = commitMacro(
+            std::move(completedMacro), event.to_pc, syscall);
+    }
+    PendingEvent completed = std::move(*this->event);
+    completed.event = event;
+    this->event.reset();
+    if (event.type != QEMU_FST_EVENT_SYSCALL) {
+        writer->event(completed);
+    }
+    return accountCommittedUser(committedUser);
+}
+
+bool
+NativeFstSession::commitPendingMacro(
+    pc_t successor, const qemu_fst_observation_event *syscallEvent)
+{
+    if (!macro) {
+        LOG_FATAL("[native-fst] Macro commit has no active record.");
+    }
+    PendingMacro completed = std::move(*macro);
+    macro.reset();
+    return accountCommittedUser(
+        commitMacro(std::move(completed), successor, syscallEvent));
+}
+
+bool
+NativeFstSession::suppressIdleMacro(const PendingMacro &pending)
+{
+    const bool user =
+        pending.state.fields[qemu_trace_extensions::kStateCpl] == 3;
+    if (user) {
+        resetPollIdle();
+        return false;
+    }
+    if (phase == CapturePhase::Warmup) {
+        return pending.pause;
+    }
+    if (phase != CapturePhase::Measurement) {
+        return false;
+    }
+    constexpr uint32_t pauseThreshold = 128;
+    constexpr uint32_t maxGapCommits = 64;
+    if (pending.pause) {
+        if (pending.pc == pollCandidatePc &&
+            pollCandidateGapCommits <= maxGapCommits) {
+            ++pollCandidatePauses;
+        } else {
+            pollCandidatePc = pending.pc;
+            pollCandidatePauses = 1;
+        }
+        pollCandidateGapCommits = 0;
+        if (pollCandidatePauses >= pauseThreshold) {
+            pollIdle = true;
+        }
+        return pollIdle;
+    }
+    if (pollCandidatePauses != 0 &&
+        ++pollCandidateGapCommits > maxGapCommits) {
+        resetPollIdle();
+        return false;
+    }
+    return pollIdle;
+}
+
+void
+NativeFstSession::resetPollIdle()
+{
+    pollCandidatePc = 0;
+    pollCandidatePauses = 0;
+    pollCandidateGapCommits = 0;
+    pollIdle = false;
+}
+
+bool NativeFstSession::eventPending() const
+{
+    return event.has_value();
+}
+
+void
+NativeFstSession::idle()
+{
+    if (!writer || phase == CapturePhase::Complete) {
+        return;
+    }
+    discardPendingMacro();
+    resetPollIdle();
+    finishIfCommonEnd();
+}
+
+void
+NativeFstSession::resume()
+{
+    if (!writer || phase == CapturePhase::Complete) {
+        return;
+    }
+    discardPendingMacro();
+    resetPollIdle();
+    finishIfCommonEnd();
+}
+
+void
+NativeFstSession::hint(const inst_t &instruction)
+{
+    const auto hint = instruction.get_hint();
+    switch (hint.first) {
+      case HINT_CMD_ROI_START:
+        publishGlobalRoiStart();
+        applyGlobalPhase(instruction.pc(), true);
+        break;
+      case HINT_CMD_ROI_MEASUREMENT:
+        publishGlobalMeasurementBegin();
+        requestMeasurement(instruction.pc(), true);
+        sawGlobalMeasurement = true;
+        break;
+      case HINT_CMD_ROI_END:
+        finishRoi(instruction.pc(), true);
+        sawGlobalEnd = true;
+        publishGlobalRoiEnd();
+        break;
+      default:
+        break;
+    }
+}
+
+void
+NativeFstSession::finishOnExit()
+{
+    if (globalCommonEndTriggered()) {
+        finishCommonEnd();
+        return;
+    }
+    if (phase != CapturePhase::Complete) {
+        LOG_FATAL(
+            "[native-fst] vCPU %u exited before capture target (%llu/%llu).",
+            id, static_cast<unsigned long long>(measuredUserMacros),
+            static_cast<unsigned long long>(config.user_macro_target));
+    }
+}
+
+bool
+NativeFstSession::complete() const
+{
+    return phase == CapturePhase::Complete;
+}
+
+} // namespace tracer::native_fst
