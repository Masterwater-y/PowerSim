+inline constexpr std::uint16_t kStateFsw = kStateFcw + 1;
+inline constexpr std::uint16_t kStateFtw = kStateFsw + 1;
+inline constexpr std::uint16_t kStateFop = kStateFtw + 1;
+inline constexpr std::uint16_t kStateFip = kStateFop + 1;
+inline constexpr std::uint16_t kStateFdp = kStateFip + 1;
+// Physical x87 register order: low 64 bits then exponent/sign in low 16 bits.
+inline constexpr std::uint16_t kStateFp80Base = kStateFdp + 1;
+inline constexpr std::uint16_t kStateSysenterCs = kStateFp80Base + 16;
+inline constexpr std::uint16_t kStateSysenterEsp = kStateSysenterCs + 1;
+inline constexpr std::uint16_t kStateSysenterEip = kStateSysenterEsp + 1;
+inline constexpr std::uint16_t kStateTscAux = kStateSysenterEip + 1;
+inline constexpr std::uint16_t kStateFieldCount = kStateTscAux + 1;
+
+inline constexpr std::uint64_t kRoiBoundaryBegin = 1;
+inline constexpr std::uint64_t kRoiBoundaryMeasurement = 2;
+inline constexpr std::uint64_t kRoiBoundaryEnd = 3;
+
+inline constexpr std::uint64_t kMemoryAttributePio = 1 << 1;
+inline constexpr std::uint64_t kMemoryAttributeMmio = 1 << 2;
+inline constexpr std::uint64_t kMemoryAttributeFrameRam = 1 << 0;
+
+enum class StructuredEventKind : std::uint64_t {
+    kInterrupt = 0,
+    kException = 1,
+    kHostcall = 2,
+    kSyscall = 3,
+};
+
+enum class VcpuState : std::uint64_t {
+    kIdle = 1,
+    kResume = 2,
+};
+
+enum class StructuredEventDisposition : std::uint64_t {
+    kBetweenInstructions = 0,
+    kRetiredTransfer = 1,
+    kUnretiredFault = 2,
+};
+
+inline constexpr std::uint64_t pack_event_metadata(
+    StructuredEventKind kind, StructuredEventDisposition disposition,
+    std::uint32_t vector, bool vectorValid,
+    std::uint32_t errorCode, bool errorCodeValid)
+{
+    return static_cast<std::uint64_t>(kind) |
+        (static_cast<std::uint64_t>(disposition) << 3) |
+        (static_cast<std::uint64_t>(vectorValid) << 5) |
+        (static_cast<std::uint64_t>(errorCodeValid) << 6) |
+        (static_cast<std::uint64_t>(vector & 0xff) << 7) |
+        (static_cast<std::uint64_t>(errorCode) << 15);
+}
+
+}  // namespace qemu_trace_extensions
+
+#endif
