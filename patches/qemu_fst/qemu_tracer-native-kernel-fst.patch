+extern const qemu_fst_observation_api_v1 *observationApi;
+
+X86State
+captureX86State()
+{
+    qemu_fst_x86_state arch{};
+    if (!observationApi || !observationApi->read_x86_state(&arch)) {
+        LOG_FATAL("[native-fst] x86 architectural state is unavailable.");
+    }
+    X86State state;
+    using namespace qemu_trace_extensions;
+    for (size_t index = 0; index < kStateGprCount; ++index) {
+        state.fields[kStateGprBase + index] = arch.gpr[index];
+    }
+    for (size_t index = 0; index < kStateXmmCount; ++index) {
+        state.fields[kStateXmmBase + index * kStateXmmWords] =
+            arch.xmm[index][0];
+        state.fields[kStateXmmBase + index * kStateXmmWords + 1] =
+            arch.xmm[index][1];
+    }
+    for (size_t index = 0; index < 8; ++index) {
+        state.fields[kStateFp80Base + index * 2] = arch.fpr[index][0];
+        state.fields[kStateFp80Base + index * 2 + 1] = arch.fpr[index][1];
+    }
+    const auto copySegment = [&state](
+        uint16_t selector, uint16_t base, uint16_t limit, uint16_t attributes,
+        const qemu_fst_x86_segment &segment) {
+        state.fields[selector] = segment.selector;
+        state.fields[base] = segment.base;
+        state.fields[limit] = segment.limit;
+        state.fields[attributes] = segment.attributes;
+    };
+    state.fields[kStateRflags] = arch.rflags;
+    state.fields[kStateCpl] = arch.cpl;
+    state.fields[kStateCr0] = arch.cr0;
+    state.fields[kStateCr2] = arch.cr2;
+    state.fields[kStateCr3] = arch.cr3;
+    state.fields[kStateCr4] = arch.cr4;
+    state.fields[kStateCr8] = arch.cr8;
+    state.fields[kStateEfer] = arch.efer;
+    copySegment(kStateCsSelector, kStateCsBase, kStateCsLimit, kStateCsFlags,
+                arch.cs);
+    copySegment(kStateSsSelector, kStateSsBase, kStateSsLimit, kStateSsFlags,
+                arch.ss);
+    copySegment(kStateEsSelector, kStateEsBase, kStateEsLimit, kStateEsFlags,
+                arch.es);
+    copySegment(kStateDsSelector, kStateDsBase, kStateDsLimit, kStateDsFlags,
+                arch.ds);
+    copySegment(kStateFsSelector, kStateFsBase, kStateFsLimit, kStateFsFlags,
+                arch.fs);
+    copySegment(kStateGsSelector, kStateGsBase, kStateGsLimit, kStateGsFlags,
+                arch.gs);
+    copySegment(kStateLdtSelector, kStateLdtBase, kStateLdtLimit,
+                kStateLdtFlags, arch.ldt);
+    copySegment(kStateTrSelector, kStateTrBase, kStateTrLimit, kStateTrFlags,
+                arch.tr);
+    state.fields[kStateGdtBase] = arch.gdt_base;
+    state.fields[kStateGdtLimit] = arch.gdt_limit;
+    state.fields[kStateIdtBase] = arch.idt_base;
+    state.fields[kStateIdtLimit] = arch.idt_limit;
+    state.fields[kStateMxcsr] = arch.mxcsr;
+    state.fields[kStateX87Top] = arch.fpstt;
+    state.fields[kStateFcw] = arch.fpuc;
+    state.fields[kStateFsw] = arch.fpus;
+    state.fields[kStateFtw] = arch.ftw;
+    state.fields[kStateFop] = arch.fpop;
+    state.fields[kStateFip] = arch.fpip;
+    state.fields[kStateFdp] = arch.fpdp;
+    state.fields[kStateStar] = arch.star;
+    state.fields[kStateLstar] = arch.lstar;
+    state.fields[kStateCstar] = arch.cstar;
+    state.fields[kStateFmask] = arch.fmask;
+    state.fields[kStateKernelGsBase] = arch.kernelgsbase;
+    state.fields[kStateSysenterCs] = arch.sysenter_cs;
+    state.fields[kStateSysenterEsp] = arch.sysenter_esp;
+    state.fields[kStateSysenterEip] = arch.sysenter_eip;
+    state.fields[kStateTscAux] = arch.tsc_aux;
+    if (arch.cpl != 0 && arch.cpl != 3) {
+        LOG_FATAL("[native-fst] Unsupported x86 privilege level %u.",
+                  arch.cpl);
+    }
+    if (arch.smm != 0) {
+        LOG_FATAL("[native-fst] SMM is outside the capture contract.");
+    }
+    if ((arch.cr3 & ~UINT64_C(0xfff)) == 0) {
+        LOG_FATAL("[native-fst] x86 state has zero address-space identity.");
+    }
+    return state;
+}
