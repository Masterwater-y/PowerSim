diff --git a/scripts/build_native_fst.sh b/scripts/build_native_fst.sh
new file mode 100644
index 0000000..f0db500
--- /dev/null
+++ b/scripts/build_native_fst.sh
@@ -0,0 +1,42 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+tracer_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
+qemu_root=${QEMU_SOURCE:-"$tracer_root/../qemu"}
+jobs=${JOBS:-$(nproc)}
+qemu_deps=${QEMU_LOCAL_DEPS:-"$tracer_root/../qemu-local-deps/glib-2.66.8"}
+
+if [[ ! -x "$qemu_root/configure" ]]; then
+    echo "QEMU_SOURCE is not a QEMU source tree: $qemu_root" >&2
+    exit 1
+fi
+if [[ ! -d "$qemu_deps/lib/pkgconfig" || ! -d "$qemu_deps/lib" ]]; then
+    echo "QEMU local GLib dependency is missing: $qemu_deps" >&2
+    exit 1
+fi
+
+git -C "$tracer_root" submodule update --init \
+    lib/concurrentqueue lib/jsoncpp lib/lz4 lib/zlib
+
+qemu_build="$qemu_root/build"
+mkdir -p "$qemu_build"
+
+export PKG_CONFIG_PATH="$qemu_deps/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
+export LD_LIBRARY_PATH="$qemu_deps/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+export LDFLAGS="${LDFLAGS:-} -Wl,-rpath,$qemu_deps/lib"
+
+(
+cd "$qemu_build"
+"$qemu_root/configure" \
+    --target-list=x86_64-softmmu \
+    --enable-plugins \
+    --disable-werror \
+    --disable-dbus-display
+)
+ninja -C "$qemu_build" -j "$jobs" \
+    qemu-system-x86_64 qemu-img tests/tcg/plugins/libdiscons.so
+make -B -C "$tracer_root/backend/dumper" -j"$jobs" \
+    "QEMU_SOURCE=$qemu_root" \
+    "CC=${CC:-gcc}" \
+    "CXX=${CXX:-g++}" \
+    "LDFLAGS=${LDFLAGS:-} -lstdc++fs -ldl"
