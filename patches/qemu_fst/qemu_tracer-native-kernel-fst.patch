+namespace tracer::native_fst {
+
+struct X86State
+{
+    std::array<uint64_t, qemu_trace_extensions::kStateFieldCount> fields{};
+};
+
+X86State captureX86State();
+
+void resetGlobalCapturePhase();
+void publishGlobalRoiStart();
+void publishGlobalMeasurementBegin();
+bool publishGlobalRoiEnd();
+bool globalRoiActive();
+bool globalCommonEndTriggered();
+uint32_t globalCommonEndTriggerCore();
+
+class NativeFstSession
+{
+  public:
+    NativeFstSession(
+        vcpu_id_t id,
+        const std::shared_ptr<buffer_manager::buffer_manager_t> &bufferManager,
+        const config_t &config);
+    ~NativeFstSession();
+
+    bool needsInstructionState() const;
+    bool instruction(const decoder::inst_t &instruction,
+                     const X86State &state);
