+void
+resetGlobalCapturePhase()
+{
+    globalRoiStarted = false;
+    globalMeasurementStarted = false;
+    globalRoiEnded = false;
+}
+
+void publishGlobalRoiStart() { globalRoiStarted = true; }
+void publishGlobalMeasurement() { globalMeasurementStarted = true; }
+void publishGlobalRoiEnd() { globalRoiEnded = true; }
+
+bool
+globalRoiActive()
+{
+    return globalRoiStarted.load() && !globalRoiEnded.load();
+}
+
+class NativeFstSession::RawWriter
+{
+  public:
+    RawWriter(vcpu_id_t id,
+              const std::shared_ptr<buffer_manager_t> &bufferManager)
+        : id(id), bufferManager(bufferManager)
+    {
+        transactionEntries.reserve(256);
+        frameBytes.reserve(512);
+        orderedAccesses.reserve(16);
+        writeHeader();
+    }
+
+    ~RawWriter() { sync(); }
+
+    void roiBegin()
+    {
+        writeEntry(makeMarker(
+            qemu_trace_extensions::kMarkerRoiBoundary,
+            qemu_trace_extensions::kRoiBoundaryBegin));
+    }
+
+    void measurementBegin()
+    {
+        writeEntry(makeMarker(
+            qemu_trace_extensions::kMarkerRoiBoundary,
+            qemu_trace_extensions::kRoiBoundaryMeasurement));
+    }
+
+    void roiEnd()
+    {
+        writeEntry(makeMarker(
+            qemu_trace_extensions::kMarkerRoiBoundary,
+            qemu_trace_extensions::kRoiBoundaryEnd));
+    }
+
+    void vcpuState(qemu_trace_extensions::VcpuState state)
+    {
+        writeEntry(makeMarker(
+            qemu_trace_extensions::kMarkerVcpuState,
+            static_cast<uint64_t>(state)));
+        haveLastState = false;
+    }
+
+    void macro(const PendingMacro &macro, pc_t successor,
+               const X86State *completionState, bool beginMeasurement)
+    {
+        beginTransaction();
+        if (beginMeasurement) {
+            measurementBegin();
+        }
+        writeEntry(makeMarker(
+            qemu_trace_extensions::kMarkerMacroBegin, macro.pc));
+        writeState(macro.state);
+        writeEncoding(macro);
+        writeEntry(make_instr(macro.pc, TRACE_TYPE_INSTR, macro.size));
+        writeTimestamp(macro.timestampRead, completionState);
+        writeAccesses(macro.accesses);
+        writeEntry(makeMarker(
+            qemu_trace_extensions::kMarkerMacroCommit, successor));
+        commitTransaction();
+    }
+
+    void event(const PendingEvent &pendingEvent)
+    {
+        const auto &event = pendingEvent.event;
+        beginTransaction();
+        writeEntry(makeMarker(
+            qemu_trace_extensions::kMarkerEventBegin, event.from_pc));
+        writeEntry(makeMarker(
+            qemu_trace_extensions::kMarkerEventMetadata,
+            qemu_trace_extensions::pack_event_metadata(
+                eventKind(event.type), eventDisposition(event.disposition),
+                event.vector, event.vector_valid, event.error_code,
+                event.error_code_valid)));
+        writeState(pendingEvent.state);
+        writeAccesses(pendingEvent.accesses);
+        writeEntry(makeMarker(
+            qemu_trace_extensions::kMarkerEventEnd, event.to_pc));
+        commitTransaction();
+    }
+
+    void finish()
+    {
+        writeEntry(make_footer());
+        sync();
+        bufferManager->send_buffer(trace_buffer_t(nullptr, 0, windowId));
+    }
+
+  private:
+    struct FrameByte
+    {
+        uint64_t vaddr = 0;
+        uint64_t paddr = 0;
+        uint8_t value = 0;
+    };
+
+    static constexpr window_id_t windowId = 0;
+    static constexpr size_t maxEntries =
+        PER_BUFFER_SIZE / sizeof(trace_entry_t);
+    const vcpu_id_t id;
+    std::shared_ptr<buffer_manager_t> bufferManager;
+    trace_entry_t *buffer = nullptr;
+    size_t size = 0;
+    std::vector<trace_entry_t> transactionEntries;
+    bool transactionActive = false;
+    bool directTransaction = false;
+    size_t transactionStart = 0;
+    X86State lastState{};
+    std::optional<X86State> outputState;
+    bool haveLastState = false;
+    std::vector<FrameByte> frameBytes;
+    std::vector<AccessFact> orderedAccesses;
+
+    static trace_entry_t makeMarker(uint16_t type, uint64_t value)
+    {
+        return make_marker(static_cast<trace_marker_type_t>(type), value);
+    }
+
+    void writeHeader()
+    {
+        writeEntry(make_header(TRACE_ENTRY_VERSION));
+        writeEntry(make_version(TRACE_ENTRY_VERSION));
+        writeEntry(make_marker(
+            TRACE_MARKER_TYPE_FILETYPE,
+            OFFLINE_FILE_TYPE_ENCODINGS |
+                OFFLINE_FILE_TYPE_SYSCALL_NUMBERS |
+                OFFLINE_FILE_TYPE_ARCH_X86_64 |
+                OFFLINE_FILE_TYPE_FULL_SYSTEM |
+                qemu_trace_extensions::kFileTypeQemuFstTransactional));
+        writeEntry(make_marker(
+            TRACE_MARKER_TYPE_CACHE_LINE_SIZE,
+            sysconf(_SC_LEVEL1_DCACHE_LINESIZE)));
+        writeEntry(make_marker(
+            TRACE_MARKER_TYPE_CHUNK_INSTR_COUNT, 100000000));
+        const auto now = std::chrono::system_clock::now();
+        const auto micros = std::chrono::duration_cast<std::chrono::microseconds>(
+            now.time_since_epoch()).count();
+        writeEntry(make_timestamp(static_cast<uint64_t>(micros)));
+        writeEntry(make_thread(static_cast<pid_t>(id)));
+        writeEntry(make_marker(TRACE_MARKER_TYPE_CPU_ID, id));
+        writeEntry(make_pid(0));
+    }
+
+    void allocate()
+    {
+        buffer = bufferManager->alloc_buffer();
+        size = 0;
+    }
+
+    void sync()
+    {
+        if (!buffer || size == 0) {
+            return;
+        }
+        bufferManager->send_buffer(trace_buffer_t(buffer, size, windowId));
+        buffer = nullptr;
+        size = maxEntries;
+    }
+
+    void writeEntry(const trace_entry_t &entry)
+    {
+        if (transactionActive) {
+            if (directTransaction) {
+                if (size < maxEntries) {
+                    std::memcpy(buffer + size, &entry, sizeof(entry));
+                    ++size;
+                    return;
+                }
+                transactionEntries.assign(
+                    buffer + transactionStart, buffer + size);
+                size = transactionStart;
+                directTransaction = false;
+            }
+            transactionEntries.push_back(entry);
+            return;
+        }
+        if (!buffer || size >= maxEntries) {
+            sync();
+            allocate();
+        }
+        std::memcpy(buffer + size, &entry, sizeof(entry));
+        ++size;
+    }
+
+    void beginTransaction()
+    {
+        if (transactionActive) {
+            LOG_FATAL("[native-fst] Nested raw transaction.");
+        }
+        transactionEntries.clear();
+        if (!buffer || size >= maxEntries) {
+            sync();
+            allocate();
+        }
+        transactionStart = size;
+        directTransaction = true;
+        transactionActive = true;
+        outputState.reset();
+    }
+
+    void commitTransaction()
+    {
+        if (!transactionActive) {
+            LOG_FATAL("[native-fst] Transaction commit without begin.");
+        }
+        transactionActive = false;
+        if (!directTransaction) {
+            size_t offset = 0;
+            while (offset < transactionEntries.size()) {
+                if (!buffer || size >= maxEntries) {
+                    sync();
+                    allocate();
+                }
+                const size_t count = std::min(
+                    maxEntries - size, transactionEntries.size() - offset);
+                std::memcpy(
+                    buffer + size, transactionEntries.data() + offset,
+                    count * sizeof(trace_entry_t));
+                size += count;
+                offset += count;
+            }
+        }
+        transactionEntries.clear();
+        directTransaction = false;
+        if (outputState) {
+            lastState = *outputState;
+            haveLastState = true;
+            outputState.reset();
+        }
+    }
+
+    void writeState(const X86State &state)
+    {
+        uint64_t low = 0;
+        uint64_t high = 0;
+        for (size_t index = 0; index < state.fields.size(); ++index) {
+            if (!haveLastState || state.fields[index] != lastState.fields[index]) {
+                if (index < 64) {
+                    low |= UINT64_C(1) << index;
+                } else {
+                    high |= UINT64_C(1) << (index - 64);
+                }
+            }
+        }
+        writeEntry(make_user_state(
+            qemu_trace_extensions::kStateBitmapLow, low));
+        writeEntry(make_user_state(
+            qemu_trace_extensions::kStateBitmapHigh, high));
+        for (size_t index = 0; index < state.fields.size(); ++index) {
+            const bool present = index < 64
+                ? low & (UINT64_C(1) << index)
+                : high & (UINT64_C(1) << (index - 64));
+            if (present) {
+                writeEntry(make_user_state(
+                    qemu_trace_extensions::kStateValue,
+                    state.fields[index]));
+            }
+        }
+        outputState = state;
+    }
+
+    void writeEncoding(const PendingMacro &macro)
+    {
+        addr_t encoding = 0;
+        const uint8_t first = std::min<uint8_t>(macro.size, sizeof(encoding));
+        std::memcpy(&encoding, macro.encoding.data(), first);
+        writeEntry(make_encoding(first, encoding));
+        if (macro.size > first) {
+            encoding = 0;
+            const uint8_t second = macro.size - first;
+            std::memcpy(
+                &encoding, macro.encoding.data() + first, second);
+            writeEntry(make_encoding(second, encoding));
+        }
+    }
+
+    void writeTimestamp(timestamp_read_t kind, const X86State *state)
+    {
+        if (kind == timestamp_read_t::kNone) {
+            return;
+        }
+        if (!state) {
+            LOG_FATAL("[native-fst] Timestamp read has no completion state.");
+        }
+        using namespace qemu_trace_extensions;
+        const uint64_t eax = state->fields[kStateGprBase];
+        const uint64_t ecx = state->fields[kStateGprBase + 1];
+        const uint64_t edx = state->fields[kStateGprBase + 2];
+        writeEntry(makeMarker(
+            kMarkerTscRead,
+            (edx & UINT64_C(0xffffffff)) << 32 |
+                (eax & UINT64_C(0xffffffff))));
+        if (kind == timestamp_read_t::kTscp) {
+            writeEntry(makeMarker(
+                kMarkerTscAuxRead, static_cast<uint32_t>(ecx)));
+        }
+    }
+
+    void writeAccess(const AccessFact &access)
+    {
+        const bool pio =
+            access.attributes & qemu_trace_extensions::kMemoryAttributePio;
+        if (!pio && !access.hasPhysicalAddress) {
+            LOG_FATAL("[native-fst] Memory fact has no physical address.");
+        }
+        if (access.attributes != 0) {
+            writeEntry(makeMarker(
+                qemu_trace_extensions::kMarkerMemoryAttributes,
+                access.attributes));
+        }
+        if (access.hasPhysicalAddress) {
+            writeEntry(makeMarker(
+                qemu_trace_extensions::kMarkerMemoryPhysicalAddress,
+                access.paddr));
+        }
+        writeEntry(make_memref(
+            access.vaddr,
+            access.isStore ? TRACE_TYPE_WRITE : TRACE_TYPE_READ,
+            access.size));
+        if (!access.hasValue) {
+            return;
+        }
+        if (access.size <= 8) {
+            uint64_t value = 0;
+            std::memcpy(&value, access.value.data(), access.size);
+            writeEntry(make_memvalue(
+                access.vaddr, TRACE_TYPE_VALUE_FULL, access.size, value));
+        } else if (access.size <= 16) {
+            uint64_t low = 0;
+            uint64_t high = 0;
+            std::memcpy(&low, access.value.data(), sizeof(low));
+            std::memcpy(
+                &high, access.value.data() + sizeof(low),
+                access.size - sizeof(low));
+            writeEntry(make_memvalue(
+                access.vaddr, TRACE_TYPE_VALUE_PART, access.size, low));
+            writeEntry(make_memvalue(
+                access.vaddr, TRACE_TYPE_VALUE_FULL, access.size, high));
+        } else {
+            LOG_FATAL("[native-fst] Access value exceeds 16 bytes.");
+        }
+    }
+
+    void writeAccesses(const std::vector<AccessFact> &accesses)
+    {
+        frameBytes.clear();
+        orderedAccesses.clear();
+        size_t byteCount = 0;
+        for (const auto &access : accesses) {
+            if (access.attributes &
+                qemu_trace_extensions::kMemoryAttributeFrameRam) {
+                byteCount += access.size;
+            }
+        }
+        frameBytes.reserve(byteCount);
+        orderedAccesses.reserve(accesses.size());
+        for (const auto &access : accesses) {
+            const bool frameRam = access.attributes &
+                qemu_trace_extensions::kMemoryAttributeFrameRam;
+            if (!frameRam) {
+                orderedAccesses.push_back(access);
+                continue;
+            }
+            if (access.isStore || !access.hasPhysicalAddress ||
+                !access.hasValue ||
+                access.attributes !=
+                    qemu_trace_extensions::kMemoryAttributeFrameRam) {
+                LOG_FATAL("[native-fst] Invalid frame RAM fact.");
+            }
+            for (size_t offset = 0; offset < access.size; ++offset) {
+                frameBytes.push_back(FrameByte{
+                    access.vaddr + offset, access.paddr + offset,
+                    access.value[offset]});
+            }
+        }
+        std::sort(
+            frameBytes.begin(), frameBytes.end(),
+            [](const FrameByte &left, const FrameByte &right) {
+                return left.vaddr < right.vaddr;
+            });
+        size_t cursor = 0;
+        while (cursor < frameBytes.size()) {
+            AccessFact access;
+            access.hasPhysicalAddress = true;
+            access.hasValue = true;
+            access.attributes =
+                qemu_trace_extensions::kMemoryAttributeFrameRam;
+            while (cursor < frameBytes.size() &&
+                   access.size < access.value.size()) {
+                const size_t groupBegin = cursor;
+                const auto first = frameBytes[cursor++];
+                while (cursor < frameBytes.size() &&
+                       frameBytes[cursor].vaddr == first.vaddr) {
+                    const auto duplicate = frameBytes[cursor++];
+                    if (duplicate.paddr != first.paddr ||
+                        duplicate.value != first.value) {
+                        LOG_FATAL(
+                            "[native-fst] Conflicting frame RAM byte at %#llx.",
+                            static_cast<unsigned long long>(first.vaddr));
+                    }
+                }
+                if (access.size != 0 &&
+                    (first.vaddr != access.vaddr + access.size ||
+                     first.paddr != access.paddr + access.size)) {
+                    cursor = groupBegin;
+                    break;
+                }
+                if (access.size == 0) {
+                    access.vaddr = first.vaddr;
+                    access.paddr = first.paddr;
+                }
+                access.value[access.size++] = first.value;
+            }
+            writeAccess(access);
+        }
+        for (const auto &access : orderedAccesses) {
+            writeAccess(access);
+        }
+    }
+};
+
+NativeFstSession::NativeFstSession(
+    vcpu_id_t id,
+    const std::shared_ptr<buffer_manager_t> &bufferManager,
+    const config_t &config)
+    : id(id), config(config), bufferManager(bufferManager)
+{
+}
+
+NativeFstSession::~NativeFstSession() = default;
+
+bool
+NativeFstSession::needsInstructionState() const
+{
+    return phase != CapturePhase::Complete &&
+        (globalRoiStarted.load() || globalRoiEnded.load());
+}
+
+void
+NativeFstSession::start()
+{
+    if (writer) {
+        return;
+    }
+    writer = std::make_unique<RawWriter>(id, bufferManager);
+    writer->roiBegin();
+    phase = CapturePhase::Warmup;
+}
+
+void
+NativeFstSession::applyGlobalPhase(pc_t nextPc, bool discardPending)
+{
+    if (globalRoiStarted.load() && !sawGlobalStart) {
+        start();
+        sawGlobalStart = true;
+    }
+    if (globalMeasurementStarted.load() && !sawGlobalMeasurement) {
+        requestMeasurement(nextPc, discardPending);
+        sawGlobalMeasurement = true;
+    }
+    if (globalRoiEnded.load() && !sawGlobalEnd) {
+        finishRoi(nextPc, discardPending);
+        sawGlobalEnd = true;
+    }
+}
+
+void
+NativeFstSession::requestMeasurement(pc_t nextPc, bool discardPending)
+{
+    if (!writer || phase != CapturePhase::Warmup) {
+        LOG_FATAL("[native-fst] Measurement boundary has no active ROI.");
+    }
+    if (discardPending) {
+        discardPendingMacro();
+    } else if (auto *macro = std::get_if<PendingMacro>(&pending)) {
+        PendingMacro completed = std::move(*macro);
+        pending = std::monostate{};
+        accountCommittedUser(commitMacro(
+            std::move(completed), nextPc, nullptr));
+    }
+    measurementPending = true;
+    backend_signal_measurement_started();
+}
+
+void
+NativeFstSession::finishRoi(pc_t nextPc, bool discardPending)
+{
+    if (phase == CapturePhase::Complete) {
+        return;
+    }
+    if (!writer || phase == CapturePhase::BeforeRoi) {
+        LOG_FATAL("[native-fst] ROI end precedes ROI start.");
+    }
+    if (discardPending) {
+        discardPendingMacro();
+    } else if (auto *macro = std::get_if<PendingMacro>(&pending)) {
+        PendingMacro completed = std::move(*macro);
+        pending = std::monostate{};
+        accountCommittedUser(commitMacro(
+            std::move(completed), nextPc, nullptr));
+    }
+    if (measuredUserMacros < config.raw_user_macro_envelope) {
+        LOG_FATAL(
+            "[native-fst] ROI ended before the capture target on vCPU %u "
+            "(%llu/%llu).", id,
+            static_cast<unsigned long long>(measuredUserMacros),
+            static_cast<unsigned long long>(
+                config.raw_user_macro_envelope));
+    }
+    writer->roiEnd();
+    writer->finish();
+    phase = CapturePhase::Complete;
+}
+
+uint64_t
+NativeFstSession::repeatCount(
+    const PendingMacro &macro, const X86State &state)
+{
+    const uint64_t count = state.fields[
+        qemu_trace_extensions::kStateGprBase + 1];
+    return macro.repeatAddress32 ? uint32_t(count) : count;
+}
+
+void
+NativeFstSession::continueRepeat(
+    const inst_t &instruction, const X86State &state)
+{
+    auto &macro = std::get<PendingMacro>(pending);
+    if (instruction.size() != macro.size ||
+        instruction.repeat() != macro.repeat ||
+        std::memcmp(
+            instruction.inst_code<const uint8_t *>(),
+            macro.encoding.data(), macro.size) != 0 ||
+        (state.fields[qemu_trace_extensions::kStateCr3] &
+         ~UINT64_C(0xfff)) !=
+            (macro.state.fields[qemu_trace_extensions::kStateCr3] &
+             ~UINT64_C(0xfff))) {
+        LOG_FATAL("[native-fst] REP restart changes instruction or ASID.");
+    }
+    using namespace qemu_trace_extensions;
+    for (const auto field : {
+             kStateCpl, kStateCr0, kStateCr3, kStateCr4, kStateEfer,
+             kStateCsSelector, kStateCsBase, kStateCsFlags,
+             kStateDsSelector, kStateDsBase, kStateDsFlags,
+             kStateEsSelector, kStateEsBase, kStateEsFlags,
+             kStateFsSelector, kStateFsBase, kStateFsFlags,
+             kStateGsSelector, kStateGsBase, kStateGsFlags}) {
+        if (state.fields[field] != macro.state.fields[field]) {
+            LOG_FATAL("[native-fst] REP changes execution context field=%u.",
+                      unsigned(field));
+        }
+    }
+    const uint64_t flags = state.fields[kStateRflags];
+    const bool zero = flags & (UINT64_C(1) << 6);
+    const uint64_t remaining = repeatCount(macro, state);
+    if ((flags ^ macro.state.fields[kStateRflags]) & (UINT64_C(1) << 10) ||
+        remaining == 0 || remaining >= macro.repeatRemaining ||
+        (macro.repeat == repeat_t::kWhileZero && !zero) ||
+        (macro.repeat == repeat_t::kWhileNotZero && zero)) {
+        LOG_FATAL("[native-fst] REP restart is not an unfinished loop.");
+    }
+    macro.repeatRemaining = remaining;
+}
+
+bool
+NativeFstSession::commitMacro(
+    PendingMacro macro, pc_t successor, const X86State *completionState)
+{
+    if (successor == 0) {
+        return false;
+    }
+    if (macro.repeat != repeat_t::kNone &&
+        successor != macro.pc + macro.size) {
+        LOG_FATAL("[native-fst] REP commit is not at fallthrough.");
+    }
+    const bool user =
+        macro.state.fields[qemu_trace_extensions::kStateCpl] == 3;
+    const bool beginMeasurement = measurementPending && user;
+    writer->macro(macro, successor, completionState, beginMeasurement);
+    if (beginMeasurement) {
+        measurementPending = false;
+        phase = CapturePhase::Measurement;
+    }
+    return user;
+}
+
+bool
+NativeFstSession::accountCommittedUser(bool committedUser)
+{
+    if (!committedUser || phase != CapturePhase::Measurement) {
+        return false;
+    }
+    ++measuredUserMacros;
+    if (measuredUserMacros < config.raw_user_macro_envelope) {
+        return false;
+    }
+    pending = std::monostate{};
+    writer->finish();
+    phase = CapturePhase::Complete;
+    return true;
+}
+
+bool
+NativeFstSession::instruction(
+    const inst_t &instruction, const X86State &state)
+{
+    ++instructionCount;
+    applyGlobalPhase(instruction.pc(), false);
+    if (phase == CapturePhase::BeforeRoi ||
+        phase == CapturePhase::Complete) {
+        return phase == CapturePhase::Complete;
+    }
+    if (auto *macro = std::get_if<PendingMacro>(&pending);
+        macro && macro->repeat != repeat_t::kNone &&
+        instruction.pc() == macro->pc) {
+        continueRepeat(instruction, state);
+        return false;
+    }
+    bool reached = false;
+    if (auto *macro = std::get_if<PendingMacro>(&pending)) {
+        PendingMacro completed = std::move(*macro);
+        pending = std::monostate{};
+        reached = accountCommittedUser(commitMacro(
+            std::move(completed), instruction.pc(), &state));
+    } else if (std::holds_alternative<PendingEvent>(pending)) {
+        LOG_FATAL("[native-fst] Instruction overlaps an open event.");
+    }
+    if (reached) {
+        return true;
+    }
+    PendingMacro macro;
+    macro.pc = instruction.pc();
+    macro.size = instruction.size();
+    std::memcpy(
+        macro.encoding.data(),
+        instruction.inst_code<const uint8_t *>(), macro.size);
+    macro.timestampRead = instruction.timestamp_read();
+    macro.repeat = instruction.repeat();
+    macro.repeatAddress32 = instruction.repeat_address32();
+    macro.state = state;
+    macro.repeatRemaining = repeatCount(macro, state);
+    macro.accesses.reserve(8);
+    pending = std::move(macro);
+    return false;
+}
+
+void
+NativeFstSession::memory(const AccessFact &access)
+{
+    if (auto *macro = std::get_if<PendingMacro>(&pending)) {
+        macro->accesses.push_back(access);
+        return;
+    }
+    if (phase != CapturePhase::Complete) {
+        LOG_FATAL("[native-fst] Memory callback has no pending macro.");
+    }
+}
+
+void
+NativeFstSession::discardPendingMacro(bool noRepeatIterationRetired)
+{
+    auto *macro = std::get_if<PendingMacro>(&pending);
+    if (!macro) {
+        return;
+    }
+    if (macro->repeat != repeat_t::kNone &&
+        !noRepeatIterationRetired &&
+        (macro->repeatRemaining != repeatCount(*macro, macro->state) ||
+         !macro->accesses.empty())) {
+        LOG_FATAL("[native-fst] Cannot discard unresolved REP.");
+    }
+    pending = std::monostate{};
+}
+
+bool
+NativeFstSession::eventBegin(
+    const qemu_fst_observation_event &event, const X86State &state)
+{
+    applyGlobalPhase(event.from_pc, false);
+    if (phase == CapturePhase::BeforeRoi ||
+        phase == CapturePhase::Complete) {
+        return phase == CapturePhase::Complete;
+    }
+    if (std::holds_alternative<PendingEvent>(pending)) {
+        LOG_FATAL("[native-fst] Nested event on vCPU %u.", id);
+    }
+    auto *macro = std::get_if<PendingMacro>(&pending);
+    if (macro && macro->repeat != repeat_t::kNone &&
+        (event.disposition == QEMU_FST_EVENT_UNRETIRED_FAULT ||
+         event.from_pc == macro->pc)) {
+        if (repeatCount(*macro, state) != repeatCount(*macro, macro->state)) {
+            LOG_FATAL("[native-fst] REP crossed an event after progress.");
+        }
+        discardPendingMacro(true);
+        macro = nullptr;
+    }
+    bool reached = false;
+    if (event.disposition == QEMU_FST_EVENT_UNRETIRED_FAULT) {
+        discardPendingMacro();
+    } else if (event.disposition == QEMU_FST_EVENT_BETWEEN_INSTRUCTIONS &&
+               macro) {
+        PendingMacro completed = std::move(*macro);
+        pending = std::monostate{};
+        reached = accountCommittedUser(commitMacro(
+            std::move(completed), event.from_pc, &state));
+    }
+    if (reached) {
+        return true;
+    }
+    PendingEvent pendingEvent;
+    pendingEvent.event = event;
+    pendingEvent.state = state;
+    pendingEvent.accesses.reserve(16);
+    if (event.disposition == QEMU_FST_EVENT_RETIRED_TRANSFER) {
+        if (auto *retired = std::get_if<PendingMacro>(&pending)) {
+            pendingEvent.retiredMacro = std::move(*retired);
+        }
+    }
+    pending = std::move(pendingEvent);
+    return false;
+}
+
+void
+NativeFstSession::eventMemory(const AccessFact &access)
+{
+    auto *event = std::get_if<PendingEvent>(&pending);
+    if (!event) {
+        if (phase != CapturePhase::Complete) {
+            LOG_FATAL("[native-fst] Event memory has no pending event.");
+        }
+        return;
+    }
+    event->accesses.push_back(access);
+}
+
+bool
+NativeFstSession::eventEnd(const qemu_fst_observation_event &event)
+{
+    auto *open = std::get_if<PendingEvent>(&pending);
+    if (!open) {
+        return phase == CapturePhase::Complete;
+    }
+    if (open->event.type != event.type ||
+        open->event.disposition != event.disposition ||
+        open->event.from_pc != event.from_pc ||
+        open->event.vector != event.vector ||
+        open->event.vector_valid != event.vector_valid ||
+        open->event.error_code != event.error_code ||
+        open->event.error_code_valid != event.error_code_valid) {
+        LOG_FATAL("[native-fst] Event begin/end mismatch.");
+    }
+    if (event.nested) {
+        LOG_FATAL("[native-fst] Nested event is unsupported.");
+    }
+    if ((event.type == QEMU_FST_EVENT_INTERRUPT ||
+         event.type == QEMU_FST_EVENT_EXCEPTION) &&
+        !event.vector_valid) {
+        LOG_FATAL("[native-fst] Interrupt/exception has no vector.");
+    }
+    PendingEvent completed = std::move(*open);
+    completed.event = event;
+    pending = std::monostate{};
+    bool committedUser = false;
+    if (completed.retiredMacro) {
+        committedUser = commitMacro(
+            std::move(*completed.retiredMacro), event.to_pc,
+            &completed.state);
+    }
+    writer->event(completed);
+    return accountCommittedUser(committedUser);
+}
+
+bool NativeFstSession::eventPending() const
+{
+    return std::holds_alternative<PendingEvent>(pending);
+}
+
+void
+NativeFstSession::idle()
+{
+    if (!writer || phase == CapturePhase::Complete) {
+        return;
+    }
+    discardPendingMacro();
+    writer->vcpuState(qemu_trace_extensions::VcpuState::kIdle);
+    idleState = true;
+}
+
+void
+NativeFstSession::resume()
+{
+    if (!writer || phase == CapturePhase::Complete) {
+        return;
+    }
+    discardPendingMacro();
+    writer->vcpuState(qemu_trace_extensions::VcpuState::kResume);
+    idleState = false;
+}
+
+void
+NativeFstSession::hint(const inst_t &instruction)
+{
+    const auto hint = instruction.get_hint();
+    switch (hint.first) {
+      case HINT_CMD_ROI_START:
+        publishGlobalRoiStart();
+        applyGlobalPhase(instruction.pc(), true);
+        break;
+      case HINT_CMD_ROI_MEASUREMENT:
+        publishGlobalMeasurement();
+        applyGlobalPhase(instruction.pc(), true);
+        break;
+      case HINT_CMD_ROI_END:
+        publishGlobalRoiEnd();
+        applyGlobalPhase(instruction.pc(), true);
+        break;
+      default:
+        break;
+    }
+}
+
+void
+NativeFstSession::finishOnExit()
+{
+    if (phase != CapturePhase::Complete) {
+        LOG_FATAL(
+            "[native-fst] vCPU %u exited before capture target (%llu/%llu).",
+            id, static_cast<unsigned long long>(measuredUserMacros),
+            static_cast<unsigned long long>(
+                config.raw_user_macro_envelope));
+    }
+}
+
+bool
+NativeFstSession::complete() const
+{
+    return phase == CapturePhase::Complete;
+}
+
