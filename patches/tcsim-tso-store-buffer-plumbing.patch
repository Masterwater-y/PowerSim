+def configure_o3_tso_store(processor, mode, buffer_size, cache_hierarchy):
+    if buffer_size <= 0:
+        fail("--tso-store-buffer-size must be positive")
+    if mode == "buffer" and cache_hierarchy != "mesi-three-level":
+        fail(
+            "--tso-store=buffer currently requires "
+            "--cache-hierarchy=mesi-three-level"
+        )
+    configured = 0
+    for cores in processor._switchable_cores.values():
+        for core in cores:
+            simobject = core.get_simobject()
+            if not hasattr(simobject, "tsoStore"):
+                continue
+            simobject.tsoStore = mode
+            simobject.tsoStoreBufferSize = buffer_size
+            if mode == "buffer":
+                simobject.SQEntries = buffer_size
+            configured += 1
+    if mode == "buffer" and configured == 0:
+        fail(
+            "--tso-store=buffer requires a gem5 binary with the "
+            "BaseO3CPU.tsoStore parameter"
+        )
+    if configured:
+        effective_sq = buffer_size if mode == "buffer" else "profile"
+        print(
+            f"[fs-ckpt] configured O3 TSO store={mode} "
+            f"buffer_size={buffer_size} effective_sq={effective_sq} "
+            f"cores={configured}"
+        )
+
