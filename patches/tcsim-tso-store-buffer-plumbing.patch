+def preserve_uarch_profile(trace_scratch, result_dir, keep_scratch):
+    profile_source = trace_scratch / "uarch_profile.json"
+    if not profile_source.is_file():
+        return None
+    profile_target = result_dir / "tao_trace/uarch_profile.json"
+    profile_target.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copy2(profile_source, profile_target)
+    if not keep_scratch:
+        profile_source.unlink()
+    return profile_target
