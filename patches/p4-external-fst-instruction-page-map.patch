 void
+TaoTrace::observeFstInstructionPages(
+    const DynInstPtr &inst, uint64_t address_space_id)
+{
+    if (!out_fst_ || !inst || address_space_id == 0) return;
+    const uint64_t pc = inst->pcState().instAddr();
+    uint64_t last_byte = pc;
+    const uint8_t size = inst->pcState().as<X86ISA::PCState>().size();
+    if (size != 0 && size <= 15 && pc <= UINT64_MAX - (size - 1)) {
+        last_byte = pc + size - 1;
+    }
+    const uint64_t first_page = pc >> kFstVpageBits;
+    const uint64_t last_page = last_byte >> kFstVpageBits;
+    for (uint64_t virtual_page = first_page;
+         virtual_page <= last_page; ++virtual_page) {
+        const auto observed =
+            fst_observed_instruction_pages_.find(virtual_page);
+        if (observed == fst_observed_instruction_pages_.end()) continue;
+        const auto key = std::make_pair(address_space_id, virtual_page);
+        const auto active = fst_active_instruction_pages_.find(key);
+        if (active != fst_active_instruction_pages_.end() &&
+            active->second == observed->second) {
+            continue;
+        }
+        fst_instruction_page_mappings_.push_back(
+            FstInstructionPageMapping{
+                fst_record_count_, address_space_id, virtual_page,
+                observed->second});
+        fst_active_instruction_pages_[key] = observed->second;
+        if (virtual_page == UINT64_MAX) break;
+    }
+}
+
+void
+TaoTrace::writeFstInstructionPageMap()
+{
+    if (fst_path_.empty()) return;
+    const std::string path = fst_path_ + ".ifmap";
+    if (fst_instruction_page_mappings_.empty()) {
+        std::remove(path.c_str());
+        return;
+    }
+    std::FILE *output = std::fopen(path.c_str(), "wb");
+    if (!output) {
+        throw std::runtime_error(
+            "TaoTrace failed to open FST instruction-page map");
+    }
+    FstInstructionPageMapHeaderV1 header;
+    header.core_id = fst_core_id_ >= 0 ? uint32_t(fst_core_id_) : 0u;
+    header.source_record_count = fst_record_count_;
+    header.entry_count = fst_instruction_page_mappings_.size();
+    if (std::fwrite(&header, sizeof(header), 1, output) != 1) {
+        std::fclose(output);
+        throw std::runtime_error(
+            "TaoTrace failed to write FST instruction-page map header");
+    }
+    for (const auto &mapping : fst_instruction_page_mappings_) {
+        FstInstructionPageMapEntryV1 entry;
+        entry.record_ordinal = mapping.record_ordinal;
+        entry.address_space_id = mapping.address_space_id;
+        entry.virtual_page = mapping.virtual_page;
+        entry.physical_page = mapping.physical_page;
+        if (std::fwrite(&entry, sizeof(entry), 1, output) != 1) {
+            std::fclose(output);
+            throw std::runtime_error(
+                "TaoTrace failed to write FST instruction-page map entry");
+        }
+    }
+    if (std::fflush(output) != 0 || std::fclose(output) != 0) {
+        throw std::runtime_error(
+            "TaoTrace failed to finalize FST instruction-page map");
+    }
+}
