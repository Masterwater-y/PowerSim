+/* Wait metadata ABI v1; Linux x86-64 fixed-process/no-fork pilot.
+   Attempts and syscall returns never prove that a task blocked or ran. */
+#ifndef GOMP_FASTSIM_WAIT_H
+#define GOMP_FASTSIM_WAIT_H
+extern unsigned long long gomp_fastsim_thread_id (void);
+extern unsigned long long gomp_fastsim_wait_begin (unsigned long long,
+                                                  unsigned long long, int, int);
+extern void gomp_fastsim_wait_end (unsigned long long, unsigned long long,
+                                 unsigned long long, long);
+#endif
--- a/team.c
+++ b/team.c
@@ -31,6 +31,9 @@
 #include <stdlib.h>
 #include <string.h>
 #include "fastsim_sync.h"
+#include "fastsim_wait.h"
+#include <unistd.h>
+#include <sys/syscall.h>
 
 static unsigned long long fastsim_next_region;
 static unsigned long long fastsim_next_thread;
@@ -48,15 +51,65 @@
          ".type fastsim_sync_marker,@function\nfastsim_sync_marker:\n"
          "nop\nret\n.size fastsim_sync_marker,.-fastsim_sync_marker\n");
 
+/* This pilot forbids fork after runtime initialization: cached OS identities,
+   runtime IDs and request sequence are lifetime-local and not reset at fork. */
+static __thread unsigned long long fastsim_os_tid;
+static __thread unsigned long long fastsim_os_tgid;
+static __thread unsigned long long fastsim_wait_request;
+
+extern void fastsim_wait_marker (unsigned long long, unsigned long long,
+                                unsigned long long, unsigned long long,
+                                unsigned long long, unsigned long long);
+__asm__ (".text\n.weak fastsim_wait_marker\n"
+         ".type fastsim_wait_marker,@function\nfastsim_wait_marker:\n"
+         "nop\nret\n.size fastsim_wait_marker,.-fastsim_wait_marker\n");
+
+unsigned long long
+gomp_fastsim_thread_id (void)
+{
+  if (!fastsim_thread_id)
+    fastsim_thread_id = __atomic_add_fetch (&fastsim_next_thread, 1,
+                                           __ATOMIC_RELAXED);
+  /* Initialize before invoking the weak observer, avoiding identity recursion.
+     The shared getter covers sync-only/compute threads before any marker. */
+  if (!fastsim_os_tid)
+    {
+      fastsim_os_tid = (unsigned long long) syscall (SYS_gettid);
+      fastsim_os_tgid = (unsigned long long) getpid ();
+      fastsim_wait_marker (1, fastsim_thread_id, fastsim_os_tid, 0, 0,
+                           fastsim_os_tgid);
+    }
+  return fastsim_thread_id;
+}
+
+unsigned long long
+gomp_fastsim_wait_begin (unsigned long long kind, unsigned long long object,
+                         int futex_op, int value)
+{
+  unsigned long long runtime_id = gomp_fastsim_thread_id ();
+  unsigned long long request = ++fastsim_wait_request;
+  if (!request) abort ();
+  unsigned long long detail = ((unsigned long long) (unsigned int) futex_op << 32)
+                               | (unsigned int) value;
+  fastsim_wait_marker (kind, runtime_id, fastsim_os_tid, request, object, detail);
+  return request;
+}
+
+void
+gomp_fastsim_wait_end (unsigned long long kind, unsigned long long object,
+                       unsigned long long request, long result)
+{
+  fastsim_wait_marker (kind, gomp_fastsim_thread_id (), fastsim_os_tid,
+                       request, object, (unsigned long long) result);
+}
+
