+        uint32_t core_id = 0;
+        uint32_t thread_id = 0;
+        uint64_t first_seq = 0;
+        uint64_t macro_pc = 0;
+        int      op_class = 0;
+        bool     any_load = false;
+        bool     any_store = false;
+        bool     any_locked_rmw = false;
