+uint64_t
+TaoTrace::ticksToCycles(uint64_t ticks, const DynInstPtr &inst) const
+{
+    if (!inst->cpu) return ticks;
+    Tick period = inst->cpu->clockPeriod();
+    return period ? ticks / period : ticks;
+}
+
+uint8_t
+TaoTrace::bucketCount(size_t n)
+{
+    if (n == 0) return 0;
+    if (n == 1) return 1;
+    if (n == 2) return 2;
+    if (n <= 7) return 3;
+    return 4;  // 8+
+}
