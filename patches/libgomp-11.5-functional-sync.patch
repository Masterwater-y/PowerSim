+static unsigned long long fastsim_next_region;
+static unsigned long long fastsim_next_thread;
+static __thread unsigned long long fastsim_thread_id;
+static __thread unsigned long long fastsim_current_region;
+static __thread unsigned long long fastsim_current_members;
+static __thread unsigned fastsim_unsupported_nested;
+
+/* Weak transport allows a test-only host observer to replace it.  Production
+   payload is sampled only at the successful retirement of this single nop. */
+extern void fastsim_sync_marker (unsigned long long, unsigned long long,
+                                unsigned long long, unsigned long long,
+                                unsigned long long, unsigned long long);
+__asm__ (".text\n.weak fastsim_sync_marker\n"
+         ".type fastsim_sync_marker,@function\nfastsim_sync_marker:\n"
+         "nop\nret\n.size fastsim_sync_marker,.-fastsim_sync_marker\n");
+
+void
+gomp_fastsim_sync_emit (unsigned long long kind, struct gomp_team *team,
+                        unsigned long long object, unsigned long long generation)
+{
+  struct gomp_thread *thr = gomp_thread ();
+  if (!team) return;
+  if (!fastsim_thread_id)
+    fastsim_thread_id = __atomic_add_fetch (&fastsim_next_thread, 1,
+                                           __ATOMIC_RELAXED);
+  /* Team storage and even thr->ts may be reassigned by the master before
+     a worker emits its old final departure. Snapshot identity at safe entry
+     points and never read the reused state at the later departure. */
+  if (kind == 1 || kind == 3)
+    {
+      if (thr->ts.level > 1) fastsim_unsupported_nested = 1;
+      fastsim_current_region = team->fastsim_sync_region;
+      fastsim_current_members = ((unsigned long long) team->nthreads << 32)
+                                | thr->ts.team_id;
+    }
+  if (fastsim_unsupported_nested) kind = 9;
+  fastsim_sync_marker (kind, fastsim_thread_id, fastsim_current_region,
+                       object, generation, fastsim_current_members);
+}
