+def _fst_feature_flags(path):
+    with path.open("rb") as handle:
+        header = handle.read(40)
+    if len(header) != 40 or header[:8] != b"FSTRC01\0":
+        raise SystemExit(f"invalid FST header: {path}")
+    return int.from_bytes(header[32:40], "little")
+
+
+def _fst_last_op_class(path, record_count):
+    if record_count == 0:
+        return None
+    with path.open("rb") as handle:
+        handle.seek(72 + (record_count - 1) * 64 + 52)
+        raw = handle.read(2)
+    if len(raw) != 2:
+        raise SystemExit(f"truncated final FST record: {path}")
+    return int.from_bytes(raw, "little", signed=True)
+
